# Google Sheets Integration (for /api/interest serverless function)
# See api/interest.ts for activation instructions

# The ID of your Google Sheet (found in the sheet URL)
# e.g. https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEETS_ID=

# Google Service Account credentials as a JSON string
# Download from Google Cloud Console → IAM & Admin → Service Accounts → Keys
GOOGLE_CREDENTIALS=
