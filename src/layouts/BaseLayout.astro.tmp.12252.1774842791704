---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { ViewTransitions } from 'astro:transitions';
import { inject } from '@vercel/analytics';

interface Props {
  title: string;
  description?: string;
  /** Relative or absolute OG image path. Defaults to /og-default.svg */
  ogImage?: string;
  /** Pass true to noindex hidden pages */
  noIndex?: boolean;
  /** Additional JSON-LD schema to inject (serialised string) */
  schemaJson?: string;
}

const {
  title,
  description = siteConfig.description,
  ogImage = '/og-default.svg',
  noIndex = false,
  schemaJson,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://upgyaan.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// SEO-optimised titles
const pageTitle = title === 'UpGyaan'
  ? `UpGyaan — ${siteConfig.tagline}`
  : `${title} | UpGyaan`;

// OG image must be absolute
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Organisation schema (always present — helps Google knowledge graph)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UpGyaan',
  url: siteUrl,
  logo: `${siteUrl}/brand/logo.png`,
  description: siteConfig.description,
  sameAs: [
    siteConfig.social.linkedin,
    siteConfig.social.twitter,
    siteConfig.social.youtube,
    siteConfig.social.instagram,
  ].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- ── Primary SEO ────────────────────────────────────── -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- ── Open Graph ─────────────────────────────────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="UpGyaan" />
    <meta property="og:locale" content="en_US" />

    <!-- ── Twitter / X Card ───────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- ── Schema.org structured data ────────────────────── -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}

    <!-- ── Google Fonts ───────────────────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
    />

    <!-- ── View Transitions ───────────────────────────────── -->
    <ViewTransitions />
  </head>
  <body>
    <!-- Skip navigation — WCAG 2.4.1 bypass blocks -->
    <a href="#main-content" class="skip-to-main">Skip to main content</a>

    <Nav />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- ── Cookie notice (GDPR essential-only) ────────────── -->
    <div id="cookie-notice" class="cookie-notice" role="region" aria-label="Cookie notice" hidden>
      <p class="cookie-text">
        We use essential cookies only — no tracking, no advertising.
        <a href="/privacy">Learn more</a>
      </p>
      <button id="cookie-dismiss" class="cookie-dismiss" type="button" aria-label="Dismiss cookie notice">
        Got it
      </button>
    </div>
  </body>
</html>

<style>
  .cookie-notice {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #0A1628;
    color: rgba(255,255,255,0.9);
    padding: 0.875rem 1.25rem;
    border-radius: 10px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.25);
    max-width: calc(100vw - 2rem);
    width: max-content;
    animation: slide-up 0.3s ease;
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateX(-50%) translateY(12px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .cookie-notice[hidden] { display: none; }

  .cookie-text {
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.5;
  }

  .cookie-text a {
    color: var(--color-amber, #F9A825);
    text-underline-offset: 2px;
  }

  .cookie-dismiss {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.375rem 0.875rem;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s ease;
  }

  .cookie-dismiss:hover { background: rgba(255,255,255,0.22); }

  @media (prefers-reduced-motion: reduce) {
    .cookie-notice { animation: none; }
    .cookie-dismiss { transition: none; }
  }
</style>

<script>
  // ── Cookie notice ──────────────────────────────────────
  const notice = document.getElementById('cookie-notice');
  const btn = document.getElementById('cookie-dismiss');

  if (notice && !localStorage.getItem('cookie-dismissed')) {
    notice.hidden = false;
  }

  btn?.addEventListener('click', () => {
    localStorage.setItem('cookie-dismissed', '1');
    if (notice) notice.hidden = true;
  });

  // ── Scroll reveal ──────────────────────────────────────
  // Observes elements with class="reveal" and adds "is-visible" when they
  // enter the viewport. Works across page navigations (Astro ViewTransitions).
  function initReveal() {
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    if (!revealEls.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );

    revealEls.forEach(el => observer.observe(el));
  }

  // Run on first load
  initReveal();

  // Re-run after Astro page transitions
  document.addEventListener('astro:page-load', initReveal);
</script>
