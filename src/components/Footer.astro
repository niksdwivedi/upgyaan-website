---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'Newsletter', href: '/newsletter' },
  { label: 'About', href: '/about' },
  { label: 'Community', href: '/community' },
  { label: 'For Mentors', href: '/for-mentors' },
  { label: 'Roadmap', href: '/roadmap' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Privacy Policy', href: '/privacy' },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="UpGyaan — return to homepage">
        <img src="/brand/logo.png" alt="UpGyaan" width="120" height="40" loading="lazy" />
      </a>
      <p class="footer-tagline">{siteConfig.tagline}</p>
      {siteConfig.contact.email && (
        <a href={`mailto:${siteConfig.contact.email}`} class="footer-email">
          {siteConfig.contact.email}
        </a>
      )}
    </div>

    <div class="footer-right">
      <nav class="footer-nav" aria-label="Footer navigation">
        <ul role="list">
          {footerLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Social links — only shown if configured -->
      {(siteConfig.social.linkedin || siteConfig.social.twitter || siteConfig.social.instagram || siteConfig.social.youtube) && (
        <div class="footer-social" aria-label="UpGyaan social profiles">
          {siteConfig.social.linkedin && (
            <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="UpGyaan on LinkedIn (opens in a new tab)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {siteConfig.social.twitter && (
            <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="UpGyaan on X / Twitter (opens in a new tab)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.265 5.638L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
              </svg>
            </a>
          )}
          {siteConfig.social.instagram && (
            <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="UpGyaan on Instagram (opens in a new tab)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          )}
          {siteConfig.social.youtube && (
            <a href={siteConfig.social.youtube} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="UpGyaan on YouTube (opens in a new tab)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
              </svg>
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} {siteConfig.name}. All rights reserved.</p>
    <p class="footer-note">A community for tech professionals who want to grow with intention.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: 0 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) { .footer-inner { padding-inline: 3rem; } }

  .footer-brand { display: flex; flex-direction: column; gap: 0.5rem; }

  .footer-logo { display: block; text-decoration: none; }
  .footer-logo img { height: 30px; width: auto; display: block; }

  .footer-tagline { font-size: 0.875rem; color: var(--color-muted); margin: 0; }

  .footer-email {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-teal);
    text-decoration: none;
  }
  .footer-email:hover { text-decoration: underline; text-underline-offset: 3px; }

  .footer-right { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }

  @media (min-width: 640px) { .footer-right { align-items: flex-end; } }

  .footer-nav ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
  }

  .footer-nav a {
    font-size: 0.875rem; font-weight: 500;
    color: var(--color-text); text-decoration: none;
  }
  .footer-nav a:hover { color: var(--color-teal); text-decoration: underline; text-underline-offset: 3px; }

  .footer-social { display: flex; gap: 0.5rem; }

  .social-icon {
    display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .social-icon:hover { color: var(--color-teal); border-color: var(--color-teal); text-decoration: none; }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 640px) {
    .footer-bottom { flex-direction: row; justify-content: space-between; align-items: center; padding-inline: 2rem; }
  }
  @media (min-width: 1024px) { .footer-bottom { padding-inline: 3rem; } }

  .footer-bottom p { margin: 0; font-size: 0.8125rem; color: var(--color-muted); }
  .footer-note { font-style: italic; }

  @media (prefers-reduced-motion: reduce) { .social-icon { transition: none; } }
</style>
