---
import { getAvatarUrl } from '../utils/avatar';

interface Props {
  name: string;
  slug: string;
  title: string;
  bio: string;
  avatar?: string;
  linkedin: string;
  twitter?: string;
  youtube?: string;
  instagram?: string;
}

const { name, slug, title, bio, avatar, linkedin, twitter, youtube, instagram } = Astro.props;

const avatarUrl = getAvatarUrl({ name, avatar, twitter, linkedin });
const dicebearFallback = `https://api.dicebear.com/8.x/initials/svg?seed=${encodeURIComponent(name)}&backgroundColor=0d7377&textColor=ffffff`;

const socialLinks = [
  {
    href: linkedin,
    label: `${name} on LinkedIn (opens in a new tab)`,
    show: !!linkedin,
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    href: twitter ?? '',
    label: `${name} on X / Twitter (opens in a new tab)`,
    show: !!(twitter && twitter.trim()),
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.265 5.638L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>`,
  },
  {
    href: youtube ?? '',
    label: `${name} on YouTube (opens in a new tab)`,
    show: !!(youtube && youtube.trim()),
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>`,
  },
  {
    href: instagram ?? '',
    label: `${name} on Instagram (opens in a new tab)`,
    show: !!(instagram && instagram.trim()),
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
].filter(l => l.show);
---

<div class="author-card">
  <a href={`/blog/author/${slug}`} class="author-photo-link" aria-label={`View all posts by ${name}`}>
    <img
      src={avatarUrl}
      alt={name}
      class="author-photo"
      width="64" height="64"
      loading="lazy"
      onerror={`this.onerror=null;this.src='${dicebearFallback}'`}
    />
  </a>
  <div class="author-info">
    <div class="author-header">
      <div>
        <a href={`/blog/author/${slug}`} class="author-name-link">
          <span class="author-name">{name}</span>
        </a>
        <p class="author-title">{title}</p>
      </div>
      {socialLinks.length > 0 && (
        <div class="author-links" aria-label={`${name}'s profiles`}>
          {socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="author-social-link"
              aria-label={link.label}
            >
              <Fragment set:html={link.icon} />
            </a>
          ))}
        </div>
      )}
    </div>
    <p class="author-bio">{bio}</p>
  </div>
</div>

<style>
  .author-card {
    display: flex; gap: 1rem; padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: 10px;
  }

  .author-photo-link { flex-shrink: 0; display: block; text-decoration: none; }
  .author-photo {
    width: 64px; height: 64px; border-radius: 50%; object-fit: cover;
    border: 2px solid var(--color-border); display: block;
  }
  .author-photo-link:hover .author-photo { border-color: var(--color-teal); }

  .author-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.5rem; }

  .author-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap; }

  .author-name-link { text-decoration: none; }
  .author-name-link:hover .author-name { color: var(--color-teal); text-decoration: underline; text-underline-offset: 2px; }

  .author-name { display: block; font-family: var(--font-heading); font-weight: 700; font-size: 1rem; color: var(--color-black); line-height: 1.2; }
  .author-title { margin: 0.2rem 0 0; font-size: 0.875rem; color: var(--color-muted); font-style: italic; }

  .author-links { display: flex; gap: 0.4rem; align-items: center; flex-shrink: 0; }

  .author-social-link {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; color: var(--color-text);
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: 6px; text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .author-social-link:hover { color: var(--color-teal); border-color: var(--color-teal); text-decoration: none; }

  .author-bio { margin: 0; font-size: 0.9rem; color: var(--color-text); line-height: 1.6; }

  @media (prefers-reduced-motion: reduce) { .author-social-link { transition: none; } }
</style>
