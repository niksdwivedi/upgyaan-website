---
import { getAvatarUrl } from '../utils/avatar';
import { generateCoverSvg } from '../utils/cover';

interface Props {
  title: string;
  slug: string;
  description: string;
  publishDate: Date;
  author: {
    name: string;
    slug: string;
    avatar?: string;
    twitter?: string;
    linkedin?: string;
  };
  tags: string[];
  coverImage?: string;
  wordCount: number;
  featured?: boolean;
}

const { title, slug, description, publishDate, author, tags, coverImage, wordCount, featured = false } = Astro.props;

const readTime = Math.ceil(wordCount / 200);
const formattedDate = publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const dateIso = publishDate.toISOString().split('T')[0];

const avatarUrl = getAvatarUrl({ name: author.name, avatar: author.avatar, twitter: author.twitter, linkedin: author.linkedin });
const dicebearFallback = `https://api.dicebear.com/8.x/initials/svg?seed=${encodeURIComponent(author.name)}&backgroundColor=0d7377&textColor=ffffff`;
const resolvedCover = coverImage ?? generateCoverSvg({ title, tags, authorName: author.name });
---

<article class={`blog-card ${featured ? 'blog-card--featured' : ''}`}>
  <a href={`/blog/${slug}`} class="card-link" aria-label={`Read: ${title}`} tabindex="-1" aria-hidden="true">
    <div class="card-image-wrapper">
      <img src={resolvedCover} alt={`Cover image for: ${title}`} class="card-image" width="800" height="450" loading="lazy" decoding="async" />
    </div>
  </a>

  <div class="card-body">
    {tags.length > 0 && (
      <div class="card-tags" aria-label="Post tags">
        {tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <h2 class="card-title">
      <a href={`/blog/${slug}`} class="card-title-link">{title}</a>
    </h2>

    <p class="card-excerpt">{description}</p>

    <div class="card-meta">
      <a href={`/blog/author/${author.slug}`} class="card-author" aria-label={`View posts by ${author.name}`}>
        <img
          src={avatarUrl}
          alt={author.name}
          class="author-avatar"
          width="32" height="32"
          loading="lazy"
          onerror={`this.onerror=null;this.src='${dicebearFallback}'`}
        />
        <span class="author-name">{author.name}</span>
      </a>
      <div class="card-meta-right">
        <time datetime={dateIso} class="card-date">{formattedDate}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="card-read-time">{readTime} min read</span>
      </div>
    </div>
  </div>
</article>

<style>
  .blog-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; height: 100%; transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease; }
  .blog-card:hover { border-color: var(--color-teal); box-shadow: 0 8px 28px rgba(0,0,0,0.1); transform: translateY(-3px); }
  .blog-card--featured { border-color: var(--color-amber); }
  .blog-card--featured:hover { border-color: var(--color-teal); }
  .card-link { display: block; text-decoration: none; }
  .card-image-wrapper { aspect-ratio: 16/9; overflow: hidden; }
  .card-image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; display: block; }
  .blog-card:hover .card-image { transform: scale(1.03); }
  .card-image-placeholder { aspect-ratio: 16/9; background: var(--color-surface); display: flex; align-items: center; justify-content: center; }
  .card-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .card-title { font-family: var(--font-heading); font-size: 1.125rem; font-weight: 700; line-height: 1.3; color: var(--color-black); margin: 0; }
  .card-title-link { color: inherit; text-decoration: none; }
  .card-title-link:hover { color: var(--color-teal); text-decoration: underline; text-underline-offset: 3px; }
  .card-excerpt { font-size: 0.9rem; color: var(--color-text); line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--color-border); }
  .card-author { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .card-author:hover .author-name { color: var(--color-teal); text-decoration: underline; text-underline-offset: 2px; }
  .author-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--color-border); flex-shrink: 0; }
  .author-name { font-size: 0.875rem; font-weight: 500; color: var(--color-text); }
  .card-meta-right { display: flex; align-items: center; gap: 0.35rem; }
  .card-date, .card-read-time { font-size: 0.8125rem; color: var(--color-muted); }
  .meta-sep { color: var(--color-muted); font-size: 0.8125rem; }
  @media (prefers-reduced-motion: reduce) { .blog-card, .card-image { transition: none; } }
</style>
