---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { getAvatarUrl } from '../../../utils/avatar';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map(author => ({
    params: { slug: author.data.slug },
    props: { author },
  }));
}

const { author } = Astro.props;
const authorData = author.data;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const authorPosts = allPosts
  .filter(p => p.data.author === authorData.slug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

function getWordCount(body: string) {
  return body.split(/\s+/).filter(Boolean).length;
}
---

<BaseLayout
  title={`Posts by ${authorData.name}`}
  description={`${authorData.bio} — Read all articles by ${authorData.name} on UpGyaan.`}
  ogImage={getAvatarUrl({ name: authorData.name, avatar: authorData.avatar, twitter: authorData.twitter, linkedin: authorData.linkedin })}
>

  <!-- ── Author profile ─────────────────────────────────── -->
  <section class="author-hero" aria-labelledby="author-heading">
    <div class="container">
      <div class="author-profile">
        <img
          src={getAvatarUrl({ name: authorData.name, avatar: authorData.avatar, twitter: authorData.twitter, linkedin: authorData.linkedin })}
          alt={authorData.name}
          onerror={`this.onerror=null;this.src='https://api.dicebear.com/8.x/initials/svg?seed=${encodeURIComponent(authorData.name)}&backgroundColor=0d7377&textColor=ffffff'`}
          class="author-photo"
          width="100"
          height="100"
          loading="eager"
        />
        <div class="author-details">
          <h1 id="author-heading">{authorData.name}</h1>
          <p class="author-title-text">{authorData.title}</p>
          <p class="author-bio-text">{authorData.bio}</p>
          <div class="author-social" aria-label={`${authorData.name}'s profiles`}>
            {authorData.linkedin && (
              <a
                href={authorData.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label={`${authorData.name} on LinkedIn (opens in a new tab)`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
            )}
            {authorData.twitter && authorData.twitter.trim() !== '' && (
              <a
                href={authorData.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label={`${authorData.name} on X / Twitter (opens in a new tab)`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.265 5.638L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
                </svg>
                X / Twitter
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Posts grid ─────────────────────────────────────── -->
  <section class="author-posts" aria-labelledby="posts-heading">
    <div class="container">
      <h2 id="posts-heading">Posts by {authorData.name}</h2>

      {authorPosts.length === 0 ? (
        <p class="no-posts">No published posts yet. Check back soon.</p>
      ) : (
        <div class="posts-grid">
          {authorPosts.map(post => (
            <BlogCard
              title={post.data.title}
              slug={post.id}
              description={post.data.description}
              publishDate={post.data.publishDate}
              author={{
                name: authorData.name,
                slug: authorData.slug,
                avatar: authorData.avatar,
                twitter: authorData.twitter,
                linkedin: authorData.linkedin,
              }}
              tags={post.data.tags}
              coverImage={post.data.coverImage}
              wordCount={getWordCount(post.body ?? '')}
              featured={post.data.featured}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .author-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 4rem 0;
  }

  .author-profile {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (max-width: 639px) {
    .author-profile {
      flex-direction: column;
    }
  }

  .author-photo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    flex-shrink: 0;
  }

  .author-details h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    margin: 0 0 0.25rem;
  }

  .author-title-text {
    font-size: 0.9375rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 0 0 0.75rem;
  }

  .author-bio-text {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 0 1rem;
  }

  .author-social {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .social-link:hover {
    color: var(--color-teal);
    border-color: var(--color-teal);
    text-decoration: none;
  }

  /* Posts section */
  .author-posts {
    padding: 3.5rem 0 5rem;
  }

  .author-posts h2 {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 2rem;
    font-family: var(--font-heading);
  }

  .posts-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .no-posts {
    font-size: 0.9375rem;
    color: var(--color-muted);
    padding: 2rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link {
      transition: none;
    }
  }
</style>
