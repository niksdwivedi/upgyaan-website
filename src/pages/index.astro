<script>
  // Ecosystem tab explorer — re-initialised on every Astro navigation
  function initEcoTabs() {
    const ecoTabs = document.querySelectorAll<HTMLButtonElement>('.eco-tab');
    const ecoPanels = document.querySelectorAll<HTMLElement>('.eco-panel');
    if (!ecoTabs.length) return;

    ecoTabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        ecoTabs.forEach(t => { t.classList.remove('eco-tab--active'); t.setAttribute('aria-selected', 'false'); });
        ecoPanels.forEach(p => { p.hidden = true; });
        tab.classList.add('eco-tab--active');
        tab.setAttribute('aria-selected', 'true');
        ecoPanels[i].hidden = false;
      });
      // Arrow key navigation for accessibility
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); const next = ecoTabs[(i + 1) % ecoTabs.length]; next.click(); next.focus(); }
        if (e.key === 'ArrowLeft')  { e.preventDefault(); const prev = ecoTabs[(i - 1 + ecoTabs.length) % ecoTabs.length]; prev.click(); prev.focus(); }
      });
    });
  }

  document.addEventListener('astro:page-load', initEcoTabs);
</script>
