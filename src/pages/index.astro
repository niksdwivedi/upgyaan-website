---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const allAuthors = await getCollection('authors');

const recentPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

function getAuthor(authorSlug: string) {
  return allAuthors.find(a => a.data.slug === authorSlug)?.data;
}
function getWordCount(body: string) {
  return body.split(/\s+/).filter(Boolean).length;
}

const pillars = [
  {
    label: 'Academy',
    icon: '🎓',
    href: '/community/academy',
    detail: 'Career frameworks built for the specific decisions that define a tech career — not tools and syntax, but how to build upward influence, navigate a promotion cycle, make the IC-to-manager transition without losing what made you good, and communicate at the executive level when you have never had to before. Designed around inflection points, not job titles.',
    outcome: 'A clear, personalised development path — not a list of courses to complete',
  },
  {
    label: 'Mentor Circle',
    icon: '🤝',
    href: '/community/mentor-circle',
    detail: 'Agenda-free guidance from people who navigated the exact transition you are approaching. Mentors include senior leaders from large enterprises, startup founders, and academic researchers — each bringing a different lens on what career growth actually looks like. Matching is thoughtful, not algorithmic. The relationship continues beyond the structured programme.',
    outcome: 'A mentor relationship that outlasts the structured programme and becomes a career-long resource',
  },
  {
    label: 'AI Insights',
    icon: '🤖',
    href: '/community/ai-insights',
    detail: 'Personalised career intelligence built on community signal — not generic AI advice, but real patterns extracted from the experiences of members who have made the transitions you are approaching. Watches your trajectory, surfaces what to focus on next, and validates recommendations against mentor input. The kind of clarity that usually only comes from years of hindsight.',
    outcome: 'Clarity on your highest-leverage career moves at any given moment — specific, not generic',
  },
  {
    label: 'Community Hub',
    icon: '🌐',
    href: '/community/community-hub',
    detail: 'Structured peer groups, accountability circles, and real conversations — organised by career stage, function, and geography. City Chapters bring the community in-person. Clubs connect members across geographies around shared interests. Not a feed you scroll past — a community you participate in, where contribution creates the relationships that change careers.',
    outcome: 'A small group of peers you trust — people who know your work and push you forward',
  },
  {
    label: 'Visibility Engine',
    icon: '👁',
    href: '/community/visibility-engine',
    detail: 'Strategic visibility built on expertise and community trust — not content creation for its own sake. Turn the work you are already doing into a professional footprint that travels further than your immediate team. The community reviews, amplifies, and attests to your output — so the visibility is earned, not manufactured.',
    outcome: 'A professional footprint that works for your career while you focus on doing the work',
  },
  {
    label: 'Career Launchpad',
    icon: '🚀',
    href: '/community/career-launchpad',
    detail: 'Where the community becomes opportunity. Jobs, projects, advisory roles, and speaking slots surfaced through the relationships you have built in the community — not cold applications and keyword matching. The people who find talent through UpGyaan are looking for community-attested capability, not a CV they read once.',
    outcome: 'A career move made through trust and relationship, not chance and keyword matching',
  },
];
---

<BaseLayout
  title="UpGyaan"
  description="UpGyaan is a community for tech professionals who want to grow with intention — learn what matters, connect with people who've been there, and build a career that's visible."
>

  <!-- ── Section 1: Hero ─────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <div class="hero-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        Career Growth Community for Tech Professionals
      </div>
      <p class="hero-hook">Most people chase jobs. The top 1% attract them.</p>
      <h1 id="hero-heading" class="hero-heading">
        Your career in tech<br />deserves more than luck
      </h1>
      <p class="hero-sub">
        UpGyaan is where tech professionals grow with intention — whether you are building your foundations, navigating your next transition, or expanding your influence. Structured learning, real mentorship, and a community that compounds at every stage.
      </p>
      <div class="hero-actions">
        <a href="/join" class="btn-hero-primary">
          Join the community
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/about" class="btn-hero-ghost">Learn our story</a>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="hero-scroll" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M12 5v14M5 12l7 7 7-7" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </section>

  <!-- ── Section 2: Problem / Why ───────────────────────── -->
  <section class="why-section reveal" aria-labelledby="why-heading">
    <div class="container">
      <div class="why-inner">
        <div class="why-text">
          <p class="section-kicker">The problem we're solving</p>
          <h2 id="why-heading">Most career growth in tech is accidental</h2>
          <p>
            Whether you are just starting out in an AI-disrupted world with no clear map, navigating the gap between doing excellent work and getting recognised for it, or a senior leader trying to stay sharp and extend your influence beyond your current role — the infrastructure to help you do any of this intentionally has never been built properly.
          </p>
          <p>
            UpGyaan was built because the career infrastructure that tech professionals actually need — structured mentorship, strategic visibility, and a community that compounds — simply didn't exist.
          </p>
          <a href="/about" class="text-link">
            Read why we built this
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
        <div class="why-cards">
          <div class="why-card why-card--problem">
            <div class="why-card-icon" aria-hidden="true">⚠️</div>
            <h3>Without UpGyaan</h3>
            <ul>
              <li>No clear map when starting out in an AI-disrupted world</li>
              <li>Mentorship designed for the company, not you</li>
              <li>Skills invisible beyond your immediate team</li>
              <li>Career moves feel accidental, not intentional</li>
            </ul>
          </div>
          <div class="why-card why-card--solution">
            <div class="why-card-icon" aria-hidden="true">✦</div>
            <h3>With UpGyaan</h3>
            <ul>
              <li>Agenda-free mentorship from people ahead of you</li>
              <li>Visibility that makes your work travel further than your team</li>
              <li>A framework for intentional career growth</li>
              <li>A community where contribution creates real exposure</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Section 3: What is UpGyaan (3 col) ─────────────── -->
  <section class="what-section reveal" aria-labelledby="what-heading">
    <div class="container">
      <p class="section-kicker">What we are</p>
      <h2 id="what-heading" class="section-heading">
        Not just a platform. A community built for the long game.
      </h2>
      <div class="what-grid">
        <div class="what-col">
          <div class="what-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 4L4 9v10l10 5 10-5V9L14 4z" stroke="#0D7377" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M4 9l10 5 10-5M14 14v10" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Learn</h3>
          <p>Access structured knowledge and career frameworks designed for the realities of tech — not generic business advice repackaged as insight.</p>
        </div>
        <div class="what-col">
          <div class="what-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="10" cy="10" r="5" stroke="#0D7377" stroke-width="1.5"/>
              <circle cx="20" cy="18" r="5" stroke="#0D7377" stroke-width="1.5"/>
              <path d="M15 10.5c1 .5 3 2 3 4.5" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Grow</h3>
          <p>Connect with mentors and peers who have navigated the transitions you are approaching. Get the guidance that your organisation's programme was never designed to give.</p>
        </div>
        <div class="what-col">
          <div class="what-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 4v4M14 20v4M4 14h4M20 14h4" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="14" cy="14" r="6" stroke="#0D7377" stroke-width="1.5"/>
              <circle cx="14" cy="14" r="2" fill="#0D7377"/>
            </svg>
          </div>
          <h3>Thrive</h3>
          <p>Turn growth into opportunity — with the community, visibility, and showcasable outcomes to make your career move on your terms, not your organisation's timeline.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Section 4: The Ecosystem — Tab Explorer ──────────── -->
  <section class="ecosystem-section reveal" aria-labelledby="ecosystem-heading">
    <div class="container">
      <p class="section-kicker">The ecosystem</p>
      <h2 id="ecosystem-heading" class="section-heading">
        Everything your career needs, in one place
      </h2>
      <p class="section-sub">Six interconnected pillars. Click any to explore what it means for you.</p>

      <div class="eco-explorer" role="tablist" aria-label="UpGyaan ecosystem pillars">
        <!-- Tab buttons -->
        <div class="eco-tabs">
          {pillars.map((p, i) => (
            <button
              class={`eco-tab ${i === 0 ? 'eco-tab--active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`eco-panel-${i}`}
              id={`eco-tab-${i}`}
              data-index={i}
              type="button"
            >
              <span class="eco-tab-icon" aria-hidden="true">{p.icon}</span>
              <span class="eco-tab-label">{p.label}</span>
            </button>
          ))}
        </div>

        <!-- Panels -->
        <div class="eco-panels">
          {pillars.map((p, i) => (
            <div
              class="eco-panel"
              id={`eco-panel-${i}`}
              role="tabpanel"
              aria-labelledby={`eco-tab-${i}`}
              hidden={i !== 0}
            >
              <div class="eco-panel-inner">
                <div class="eco-panel-left">
                  <div class="eco-panel-icon" aria-hidden="true">{p.icon}</div>
                </div>
                <div class="eco-panel-content">
                  <h3 class="eco-panel-name">{p.label}</h3>
                  <p class="eco-panel-desc">{p.detail}</p>
                  <div class="eco-panel-meta">
                    <div class="eco-meta-item">
                      <span class="eco-meta-label">Key outcome</span>
                      <span class="eco-meta-value">{p.outcome}</span>
                    </div>
                  </div>
                  <a href={p.href} class="eco-panel-link">
                    Explore the {p.label}
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="ecosystem-cta">
        <a href="/community" class="text-link">
          Explore the full ecosystem
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Section 5: Vision pull quote ───────────────────── -->
  <section class="quote-section reveal" aria-label="UpGyaan vision">
    <div class="container">
      <blockquote class="vision-quote">
        <p>&#8220;The right community gives you things no individual effort can: space to grow, a stage for your work, and people who open doors you never knew existed.&#8221;</p>
        <cite>— The UpGyaan principle</cite>
      </blockquote>
    </div>
  </section>

  <!-- ── Section 6: Latest from the blog ────────────────── -->
  {recentPosts.length > 0 && (
    <section class="blog-section reveal" aria-labelledby="blog-heading">
      <div class="container">
        <p class="section-kicker">From the blog</p>
        <h2 id="blog-heading" class="section-heading">Insights from the community</h2>
        <div class="blog-grid">
          {recentPosts.map(post => {
            const author = getAuthor(post.data.author);
            if (!author) return null;
            return (
              <BlogCard
                title={post.data.title}
                slug={post.id}
                description={post.data.description}
                publishDate={post.data.publishDate}
                author={{ name: author.name, slug: author.slug, avatar: author.avatar, twitter: author.twitter, linkedin: author.linkedin }}
                tags={post.data.tags}
                coverImage={post.data.coverImage}
                wordCount={getWordCount(post.body ?? '')}
                featured={post.data.featured}
              />
            );
          })}
        </div>
        <div class="blog-link-wrap">
          <a href="/blog" class="text-link">
            View all posts
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── Section 7: Email CTA ───────────────────────────── -->
  <section class="cta-section reveal" aria-labelledby="cta-heading">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <p class="section-kicker">Be early</p>
          <h2 id="cta-heading">Get notified when we open our doors</h2>
          <p class="cta-body">
            We're building carefully. The people who register now will be among the first to join — and will help shape the community from day one.
          </p>
        </div>
        <div class="cta-form">
          <EmailCapture id="homepage-cta" context="homepage-cta" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/brand/hero-bg.svg');
    background-size: cover;
    background-position: center;
    background-color: #0a1628;
    z-index: 0;
  }

  /* Swap to a real photo: drop /public/brand/hero-bg.jpg and change the url() above */

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(10, 22, 40, 0.92) 0%,
      rgba(10, 22, 40, 0.75) 55%,
      rgba(10, 22, 40, 0.50) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 5rem;
    padding-bottom: 5rem;
    max-width: 760px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.875rem;
    background: rgba(249, 168, 37, 0.15);
    border: 1px solid rgba(249, 168, 37, 0.35);
    border-radius: 100px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #F9A825;
    letter-spacing: 0.02em;
    margin-bottom: 1.75rem;
  }

  .badge-dot {
    width: 6px; height: 6px;
    background: #F9A825;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .hero-hook {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    color: var(--color-amber);
    letter-spacing: 0.01em;
    margin: 0.75rem 0 0.5rem;
    line-height: 1.3;
  }

  .hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.175rem);
    color: rgba(255, 255, 255, 0.80);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 0 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: #F9A825;
    color: #111111;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.1s ease;
  }

  .btn-hero-primary:hover {
    background: #e69200;
    color: #111111;
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.875rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.20);
    color: rgba(255,255,255,0.90);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .btn-hero-ghost:hover {
    background: rgba(255,255,255,0.14);
    border-color: rgba(255,255,255,0.35);
    color: #fff;
    text-decoration: none;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-stat { display: flex; flex-direction: column; gap: 0.2rem; }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: #F9A825;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.55);
  }

  .hero-stat-divider {
    width: 1px; height: 36px;
    background: rgba(255,255,255,0.15);
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    animation: bounce 2.5s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  /* ── Why section ────────────────────────────────────────── */
  .why-section {
    padding: 6rem 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .why-inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .why-inner { grid-template-columns: 1fr 1fr; }
  }

  .why-text h2 {
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0.5rem 0 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .why-text .section-kicker {
    font-size: 0.875rem;
  }

  .why-text p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.75;
    margin: 0 0 1rem;
  }

  .why-cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 480px) {
    .why-cards { grid-template-columns: 1fr 1fr; }
  }

  .why-card {
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .why-card--problem { background: #fff8f8; border-color: #fdd; }
  .why-card--solution { background: #f0faf9; border-color: #b2dfdb; }

  .why-card-icon { font-size: 1.5rem; margin-bottom: 0.75rem; }

  .why-card h3 {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.75rem;
  }

  .why-card ul {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.5rem;
  }

  .why-card li {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: 1.25rem;
    position: relative;
  }

  .why-card li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.45em;
    width: 6px; height: 6px;
    border-radius: 50%;
  }

  .why-card--problem li::before { background: #e74c3c; }
  .why-card--solution li::before { background: #0D7377; }

  /* ── What section ───────────────────────────────────────── */
  .what-section {
    padding: 6rem 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .what-grid {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .what-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .what-icon {
    width: 52px; height: 52px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1rem;
  }

  .what-col h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem; font-weight: 700;
    color: var(--color-black); margin: 0 0 0.75rem;
  }

  .what-col p { font-size: 0.9375rem; color: var(--color-text); line-height: 1.7; margin: 0; }

  /* ── Ecosystem Tab Explorer ─────────────────────────────── */
  .ecosystem-section {
    padding: 6rem 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .section-sub {
    font-size: 1rem; color: var(--color-text);
    max-width: 520px; margin: 0.5rem 0 0;
  }

  .eco-explorer {
    margin-top: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
  }

  /* Tab row */
  .eco-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  @media (min-width: 768px) {
    .eco-tabs { grid-template-columns: repeat(6, 1fr); }
  }

