---
// NOTE: This page is intentionally NOT linked from any navigation.
// It exists silently at /join for direct sharing only.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Join UpGyaan"
  description="UpGyaan is opening its doors. Register your interest and be among the first to join."
  noIndex={true}
>

  <section class="join-section" aria-labelledby="join-heading">
    <div class="container">
      <div class="join-inner">
        <div class="join-text">
          <p class="join-kicker">You're early — that matters</p>
          <h1 id="join-heading">UpGyaan is opening its doors.<br />Be first in line.</h1>
          <p class="join-sub">
            Tell us a little about yourself. We'll reach out when the time is right — and you'll help shape what UpGyaan becomes.
          </p>

          <ul class="join-reasons" aria-label="Reasons to join">
            <li>Early access before the public launch</li>
            <li>Shape the culture and community from day one</li>
            <li>Connect with the founding cohort</li>
            <li>First to know about events and opportunities</li>
            <li>Direct input into what gets built and how</li>
          </ul>

          <!-- Community illustration -->
          <div class="join-illustration" aria-hidden="true">
            <div class="illo-card">
              <blockquote class="illo-quote">
                &#8220;The best career moves happen through relationships — not job boards.&#8221;
              </blockquote>
              <p class="illo-attr">— The UpGyaan principle</p>
            </div>
            <div class="illo-stats">
              <div class="illo-stat">
                <span class="illo-stat-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="8" cy="7" r="3" stroke="#0D7377" stroke-width="1.5"/>
                    <path d="M3 17c0-3 2-5 5-5" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="14" cy="9" r="2.5" stroke="#0D7377" stroke-width="1.5"/>
                    <path d="M11 17c0-2.5 1.5-4 3-4s3 1.5 3 4" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </span>
                <span>For learners &amp; mentors</span>
              </div>
              <div class="illo-stat">
                <span class="illo-stat-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="10" cy="10" r="7" stroke="#0D7377" stroke-width="1.5"/>
                    <path d="M10 6v4l3 2" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </span>
                <span>Building now</span>
              </div>
              <div class="illo-stat">
                <span class="illo-stat-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 3L12.5 8l5.5.8-4 3.9.9 5.5L10 15.5l-4.9 2.7.9-5.5L2 8.8l5.5-.8L10 3z" stroke="#0D7377" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>6 community pillars</span>
              </div>
              <div class="illo-stat">
                <span class="illo-stat-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8z" stroke="#0D7377" stroke-width="1.5"/>
                    <path d="M2 10h16M10 2a15.3 15.3 0 010 16M10 2a15.3 15.3 0 000 16" stroke="#0D7377" stroke-width="1.5"/>
                  </svg>
                </span>
                <span>Global community</span>
              </div>
            </div>
          </div>
        </div>

        <div class="join-form-card">
          <form
            id="join-form"
            class="join-form"
            novalidate
            aria-label="Register your interest in UpGyaan"
          >
            <!-- Full name -->
            <div class="field-group">
              <label for="join-name" class="form-label">
                Full name <span aria-hidden="true">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <input
                type="text"
                id="join-name"
                name="name"
                class="form-input"
                placeholder="Your full name"
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="join-name-error"
              />
              <span id="join-name-error" class="form-error" role="alert" aria-live="polite" hidden></span>
            </div>

            <!-- Email -->
            <div class="field-group">
              <label for="join-email" class="form-label">
                Email address <span aria-hidden="true">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <input
                type="email"
                id="join-email"
                name="email"
                class="form-input"
                placeholder="you@example.com"
                autocomplete="email"
                required
                aria-required="true"
                aria-describedby="join-email-error"
              />
              <span id="join-email-error" class="form-error" role="alert" aria-live="polite" hidden></span>
            </div>

            <!-- Country with typeahead + detect -->
            <div class="field-group">
              <label for="join-country" class="form-label">
                Country <span class="field-optional">(optional)</span>
              </label>
              <div class="input-with-action">
                <div class="autocomplete-wrap">
                  <input
                    type="text"
                    id="join-country"
                    name="country"
                    class="form-input"
                    placeholder="Start typing your country…"
                    autocomplete="off"
                    spellcheck="false"
                    aria-autocomplete="list"
                    aria-controls="country-suggestions"
                    aria-expanded="false"
                  />
                  <ul id="country-suggestions" class="suggestions-list" role="listbox" aria-label="Country suggestions" hidden></ul>
                </div>
                <button
                  type="button"
                  id="detect-country"
                  class="detect-btn"
                  title="Detect my country"
                  aria-label="Detect my country automatically"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 1v2M8 13v2M1 8h2M13 8h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
              <span id="join-country-error" class="form-error" role="alert" aria-live="polite" hidden></span>
            </div>

            <!-- City with detect -->
            <div class="field-group">
              <label for="join-city" class="form-label">
                City <span class="field-optional">(optional)</span>
              </label>
              <div class="input-with-action">
                <input
                  type="text"
                  id="join-city"
                  name="city"
                  class="form-input"
                  placeholder="e.g. Mumbai, Bangalore, London"
                  autocomplete="address-level2"
                  aria-describedby="join-city-hint"
                />
                <button
                  type="button"
                  id="detect-city"
                  class="detect-btn"
                  title="Detect my city"
                  aria-label="Detect my city automatically"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 1v2M8 13v2M1 8h2M13 8h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
              <span id="join-city-hint" class="field-hint">
                Helps us launch City Chapters near you.
              </span>
            </div>

            <!-- Message -->
            <div class="field-group">
              <label for="join-message" class="form-label">
                What do you want from UpGyaan? <span class="field-optional">(optional)</span>
              </label>
              <textarea
                id="join-message"
                name="message"
                class="form-textarea"
                placeholder="Tell us what you're hoping to get from the community…"
                rows="4"
                aria-describedby="join-message-hint"
              ></textarea>
              <span id="join-message-hint" class="field-hint">
                This helps us understand what the community needs. There are no wrong answers.
              </span>
            </div>

            <!-- Submit -->
            <button type="submit" id="join-submit" class="btn-primary join-submit">
              Register my interest
            </button>

            <!-- Form-level error -->
            <div id="join-form-error" class="form-error form-level-error" role="alert" aria-live="polite" hidden></div>
          </form>

          <!-- Success state -->
          <div id="join-success" class="join-success" role="status" aria-live="polite" aria-atomic="true" hidden>
            <div class="success-icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="22" stroke="#0D7377" stroke-width="2"/>
                <path d="M14 24l8 8 14-16" stroke="#0D7377" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h2>Thank you. You're on the list.</h2>
            <p>We'll be in touch when the time is right. Keep an eye on your inbox.</p>
          </div>
        </div>
      </div>

      <!-- What happens next -->
      <div class="what-next">
        <h3 class="what-next-heading">What happens after you register</h3>
        <ol class="what-next-list">
          <li>You'll receive a confirmation email straight away.</li>
          <li>We'll add you to the founding cohort — first access when Phase 2 opens.</li>
          <li>Before any public announcement, you'll hear from us first.</li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .join-section {
    padding: 5rem 0;
    min-height: 80vh;
  }

  .join-inner {
    display: grid;
    gap: 3rem;
    align-items: flex-start;
  }

  @media (min-width: 1024px) {
    .join-inner {
      grid-template-columns: 1fr 480px;
    }
  }

  .join-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
  }

  .join-text h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 1.25rem;
    line-height: 1.2;
  }

  .join-sub {
    font-size: 1.0625rem;
    color: var(--color-text);
    line-height: 1.75;
    max-width: 480px;
    margin: 0 0 2rem;
  }

  .join-reasons {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .join-reasons li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .join-reasons li::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background: var(--color-amber);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Illustration */
  .join-illustration {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .illo-card {
    background: linear-gradient(135deg, #f0faf9 0%, #e8f5f5 100%);
    border: 1px solid rgba(13, 115, 119, 0.15);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .illo-quote {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-black);
    line-height: 1.5;
    margin: 0 0 0.625rem;
    font-style: normal;
  }

  .illo-attr {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
    font-style: italic;
  }

  .illo-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }

  .illo-stat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.625rem 0.75rem;
  }

  .illo-stat-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-teal);
  }

  /* Form card */
  .join-form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
  }

  .join-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Country/city input with detect button */
  .input-with-action {
    display: flex;
    gap: 0.5rem;
  }

  .input-with-action .form-input {
    flex: 1;
    min-width: 0;
  }

  .autocomplete-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .autocomplete-wrap .form-input {
    width: 100%;
  }

  .suggestions-list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1.5px solid var(--color-teal);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    max-height: 220px;
    overflow-y: auto;
    z-index: 100;
    list-style: none;
    padding: 0.375rem 0;
    margin: 0;
  }

  .suggestions-list[hidden] { display: none; }

  .suggestions-list li {
    padding: 0.5rem 0.875rem;
    font-size: 0.9rem;
    color: var(--color-text);
    cursor: pointer;
    transition: background 0.1s ease;
  }

  .suggestions-list li:hover,
  .suggestions-list li[aria-selected="true"] {
    background: rgba(13, 115, 119, 0.08);
    color: var(--color-teal);
  }

  .detect-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    flex-shrink: 0;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .detect-btn:hover { color: var(--color-teal); border-color: var(--color-teal); }
  .detect-btn.detecting { opacity: 0.5; cursor: not-allowed; }

  .field-optional {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .field-hint {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .join-submit {
    width: 100%;
    padding: 0.875rem;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .form-level-error {
    padding: 0.75rem 1rem;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 6px;
  }

  .form-level-error[hidden] {
    display: none;
  }

  /* Success */
  .join-success {
    text-align: center;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .join-success[hidden] {
    display: none;
  }

  .success-icon {
    color: var(--color-teal);
  }

  .join-success h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0;
  }

  .join-success p {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0;
  }

  .what-next {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    background: #f0faf9;
    border: 1px solid rgba(13, 115, 119, 0.2);
    border-radius: 10px;
    max-width: 600px;
  }

  .what-next-heading {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-teal);
    margin: 0 0 0.875rem;
  }

  .what-next-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .what-next-list li {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  // ── Country list ───────────────────────────────────────────────
  const COUNTRIES = [
    'Afghanistan','Albania','Algeria','Andorra','Angola','Antigua and Barbuda','Argentina','Armenia','Australia','Austria',
    'Azerbaijan','Bahamas','Bahrain','Bangladesh','Barbados','Belarus','Belgium','Belize','Benin','Bhutan',
    'Bolivia','Bosnia and Herzegovina','Botswana','Brazil','Brunei','Bulgaria','Burkina Faso','Burundi','Cabo Verde','Cambodia',
    'Cameroon','Canada','Central African Republic','Chad','Chile','China','Colombia','Comoros','Congo','Costa Rica',
    'Croatia','Cuba','Cyprus','Czech Republic','Denmark','Djibouti','Dominica','Dominican Republic','Ecuador','Egypt',
    'El Salvador','Equatorial Guinea','Eritrea','Estonia','Eswatini','Ethiopia','Fiji','Finland','France','Gabon',
    'Gambia','Georgia','Germany','Ghana','Greece','Grenada','Guatemala','Guinea','Guinea-Bissau','Guyana',
    'Haiti','Honduras','Hungary','Iceland','India','Indonesia','Iran','Iraq','Ireland','Israel',
    'Italy','Jamaica','Japan','Jordan','Kazakhstan','Kenya','Kiribati','Kuwait','Kyrgyzstan','Laos',
    'Latvia','Lebanon','Lesotho','Liberia','Libya','Liechtenstein','Lithuania','Luxembourg','Madagascar','Malawi',
    'Malaysia','Maldives','Mali','Malta','Marshall Islands','Mauritania','Mauritius','Mexico','Micronesia','Moldova',
    'Monaco','Mongolia','Montenegro','Morocco','Mozambique','Myanmar','Namibia','Nauru','Nepal','Netherlands',
    'New Zealand','Nicaragua','Niger','Nigeria','North Korea','North Macedonia','Norway','Oman','Pakistan','Palau',
    'Palestine','Panama','Papua New Guinea','Paraguay','Peru','Philippines','Poland','Portugal','Qatar','Romania',
    'Russia','Rwanda','Saint Kitts and Nevis','Saint Lucia','Saint Vincent and the Grenadines','Samoa','San Marino',
    'Sao Tome and Principe','Saudi Arabia','Senegal','Serbia','Seychelles','Sierra Leone','Singapore','Slovakia',
    'Slovenia','Solomon Islands','Somalia','South Africa','South Korea','South Sudan','Spain','Sri Lanka','Sudan',
    'Suriname','Sweden','Switzerland','Syria','Taiwan','Tajikistan','Tanzania','Thailand','Timor-Leste','Togo',
    'Tonga','Trinidad and Tobago','Tunisia','Turkey','Turkmenistan','Tuvalu','Uganda','Ukraine','United Arab Emirates',
    'United Kingdom','United States','Uruguay','Uzbekistan','Vanuatu','Vatican City','Venezuela','Vietnam',
    'Yemen','Zambia','Zimbabwe',
  ];

  // Aliases that ipapi or users might type, mapped to the canonical list name
  const COUNTRY_ALIASES: Record<string, string> = {
    'usa': 'United States',
    'us': 'United States',
    'uk': 'United Kingdom',
    'uae': 'United Arab Emirates',
    'czechia': 'Czech Republic',
    'korea': 'South Korea',
    'republic of korea': 'South Korea',
    'democratic republic of the congo': 'Congo',
    'republic of the congo': 'Congo',
    'russia': 'Russia',
    'russian federation': 'Russia',
    'iran (islamic republic of)': 'Iran',
    'syrian arab republic': 'Syria',
    'viet nam': 'Vietnam',
    'lao pdr': 'Laos',
    "côte d'ivoire": 'Ivory Coast',
    'ivory coast': 'Ivory Coast',
    'myanmar (burma)': 'Myanmar',
    'eswatini (swaziland)': 'Eswatini',
    'north macedonia (fyr)': 'North Macedonia',
  };

  function matchCountry(raw: string): string {
    if (!raw) return '';
    const trimmed = raw.trim();
    // Exact match
    const exact = COUNTRIES.find(c => c === trimmed);
    if (exact) return exact;
    // Case-insensitive exact match
    const lower = trimmed.toLowerCase();
    const ci = COUNTRIES.find(c => c.toLowerCase() === lower);
    if (ci) return ci;
    // Alias lookup
    return COUNTRY_ALIASES[lower] ?? '';
  }

  function initJoinForm() {
    const form = document.getElementById('join-form') as HTMLFormElement;
    if (!form) return;

    const successEl = document.getElementById('join-success') as HTMLElement;
    const submitBtn = document.getElementById('join-submit') as HTMLButtonElement;
    const formError = document.getElementById('join-form-error') as HTMLElement;
    const countryInput = document.getElementById('join-country') as HTMLInputElement;
    const cityInput = document.getElementById('join-city') as HTMLInputElement;
    const detectCountryBtn = document.getElementById('detect-country') as HTMLButtonElement;
    const detectCityBtn = document.getElementById('detect-city') as HTMLButtonElement;
    const suggestionsList = document.getElementById('country-suggestions') as HTMLElement;
    const countryError = document.getElementById('join-country-error') as HTMLElement;

    let selectedIndex = -1;

    function showSuggestions(matches: string[]) {
      if (!matches.length) { hideSuggestions(); return; }
      suggestionsList.innerHTML = '';
      matches.forEach((country) => {
        const li = document.createElement('li');
        li.textContent = country;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          countryInput.value = country;
          clearCountryError();
          hideSuggestions();
        });
        suggestionsList.appendChild(li);
      });
      suggestionsList.hidden = false;
      countryInput.setAttribute('aria-expanded', 'true');
      selectedIndex = -1;
    }

    function hideSuggestions() {
      suggestionsList.hidden = true;
      countryInput.setAttribute('aria-expanded', 'false');
      selectedIndex = -1;
    }

    function clearCountryError() {
      if (countryError) { countryError.hidden = true; countryError.textContent = ''; }
      countryInput.removeAttribute('aria-invalid');
    }

    function validateCountryField(): boolean {
      const val = countryInput.value.trim();
      if (!val) return true; // optional field — empty is fine
      if (matchCountry(val)) {
        // Normalise to canonical name in case user typed an alias
        countryInput.value = matchCountry(val);
        clearCountryError();
        return true;
      }
      countryInput.setAttribute('aria-invalid', 'true');
      if (countryError) {
        countryError.textContent = 'Please select a country from the list, or type the full country name.';
        countryError.hidden = false;
      }
      return false;
    }

    countryInput.addEventListener('input', () => {
      clearCountryError();
      const q = countryInput.value.trim();
      if (q.length < 1) { hideSuggestions(); return; }
      const lower = q.toLowerCase();
      const startsWith = COUNTRIES.filter(c => c.toLowerCase().startsWith(lower));
      const contains = COUNTRIES.filter(c => !c.toLowerCase().startsWith(lower) && c.toLowerCase().includes(lower));
      const matches = [...startsWith, ...contains].slice(0, 8);
      showSuggestions(matches);
    });

    countryInput.addEventListener('keydown', (e) => {
      const items = suggestionsList.querySelectorAll('li');
      if (!items.length || suggestionsList.hidden) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, -1);
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        countryInput.value = (items[selectedIndex] as HTMLElement).textContent ?? '';
        clearCountryError();
        hideSuggestions();
        return;
      } else if (e.key === 'Escape') {
        hideSuggestions(); return;
      } else { return; }
      items.forEach((li, i) => li.setAttribute('aria-selected', String(i === selectedIndex)));
    });

    countryInput.addEventListener('blur', () => {
      setTimeout(() => {
        hideSuggestions();
        validateCountryField();
      }, 150);
    });

    // ── Email blur validation ────────────────────────────────────
    const emailInput = document.getElementById('join-email') as HTMLInputElement;
    const emailError = document.getElementById('join-email-error') as HTMLElement;

    emailInput?.addEventListener('blur', () => {
      const val = emailInput.value.trim();
      if (!val) return; // don't nag on empty — only validate on submit
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        emailInput.setAttribute('aria-invalid', 'true');
        emailError.textContent = 'Please enter a valid email address (e.g. you@example.com).';
        emailError.hidden = false;
      } else {
        emailInput.removeAttribute('aria-invalid');
        emailError.hidden = true;
        emailError.textContent = '';
      }
    });

    emailInput?.addEventListener('input', () => {
      if (emailInput.getAttribute('aria-invalid')) {
        emailInput.removeAttribute('aria-invalid');
        emailError.hidden = true;
        emailError.textContent = '';
      }
    });

    // ── Auto-populate country & city from IP on page load ────────
    (async () => {
      if (countryInput.value || cityInput.value) return; // don't overwrite if user already typed
      try {
        const res = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(5000) });
        if (!res.ok) return;
        const data = await res.json();
        if (!countryInput.value && data.country_name) {
          const matched = matchCountry(data.country_name);
          if (matched) countryInput.value = matched;
        }
        if (!cityInput.value && data.city) {
          cityInput.value = data.city;
        }
      } catch { /* fail silently — optional enhancement */ }
    })();

    // ── Detect buttons ───────────────────────────────────────────
    detectCountryBtn?.addEventListener('click', async () => {
      detectCountryBtn.disabled = true;
      detectCountryBtn.classList.add('detecting');
      try {
        const res = await fetch('https://ipapi.co/country_name/', { signal: AbortSignal.timeout(5000) });
        if (res.ok) {
          const raw = (await res.text()).trim();
          const matched = matchCountry(raw);
          if (matched) {
            countryInput.value = matched;
            clearCountryError();
          } else if (raw && raw.length < 80) {
            // ipapi returned something but it's not in our list — still show it, let blur validate
            countryInput.value = raw;
          }
          hideSuggestions();
        }
      } catch { /* fail silently */ } finally {
        detectCountryBtn.disabled = false;
        detectCountryBtn.classList.remove('detecting');
      }
    });

    detectCityBtn?.addEventListener('click', async () => {
      detectCityBtn.disabled = true;
      detectCityBtn.classList.add('detecting');
      try {
        const res = await fetch('https://ipapi.co/city/', { signal: AbortSignal.timeout(5000) });
        if (res.ok) {
          const val = (await res.text()).trim();
          if (val && val.length < 80 && !val.toLowerCase().includes('undefined')) {
            cityInput.value = val;
          }
        }
      } catch { /* fail silently */ } finally {
        detectCityBtn.disabled = false;
        detectCityBtn.classList.remove('detecting');
      }
    });

    // ── Form validation & submission ─────────────────────────────
    function showFieldError(fieldId: string, errorId: string, message: string) {
      const field = document.getElementById(fieldId) as HTMLInputElement;
      const errorEl = document.getElementById(errorId) as HTMLElement;
      if (field && errorEl) {
        field.setAttribute('aria-invalid', 'true');
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
    }

    function clearErrors() {
      document.querySelectorAll('.form-error').forEach(el => {
        (el as HTMLElement).hidden = true;
        (el as HTMLElement).textContent = '';
      });
      document.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'));
      formError.hidden = true;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      const nameVal = (form.querySelector('#join-name') as HTMLInputElement)?.value.trim();
      const emailVal = (form.querySelector('#join-email') as HTMLInputElement)?.value.trim();
      let hasError = false;

      if (!nameVal) {
        showFieldError('join-name', 'join-name-error', 'Please enter your full name.');
        hasError = true;
      }
      if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        showFieldError('join-email', 'join-email-error', 'Please enter a valid email address (e.g. you@example.com).');
        hasError = true;
      }
      if (!validateCountryField()) {
        hasError = true;
      }

      if (hasError) {
        const firstError = form.querySelector('[aria-invalid="true"]') as HTMLElement;
        firstError?.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        const data: Record<string, string> = {};
        new FormData(form).forEach((val, key) => { data[key] = String(val); });

        const res = await fetch('/api/interest', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.hidden = true;
          successEl.hidden = false;
          successEl.focus();
        } else {
          throw new Error('Server error');
        }
      } catch {
        formError.textContent = 'Something went wrong. Please try again or email us directly.';
        formError.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Register my interest';
      }
    });
  }

  document.addEventListener('astro:page-load', initJoinForm);
</script>
