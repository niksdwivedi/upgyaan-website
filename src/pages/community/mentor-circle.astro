---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="Mentor Circle | UpGyaan"
  description="The UpGyaan Mentor Circle — structured, agenda-free mentorship from practitioners who have navigated the career transitions you are approaching."
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="pillar-hero" aria-labelledby="mc-heading">
    <div class="container">
      <div class="pillar-hero-inner">
        <a href="/community" class="pillar-breadcrumb" aria-label="Back to Community">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Community
        </a>
        <p class="section-kicker">The Ecosystem — Mentor Circle</p>
        <div class="pillar-big-icon" aria-hidden="true">🤝</div>
        <h1 id="mc-heading">The Mentor Circle</h1>
        <p class="pillar-hero-tagline">Agenda-free guidance from people who navigated what you are facing</p>
        <a href="/roadmap" class="pillar-status" aria-label="Status: Coming in a future phase — see the roadmap">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Coming in a future phase — see the roadmap
        </a>
      </div>
    </div>
  </section>

  <!-- ── Section 1: What makes this different ─────────────── -->
  <section class="pillar-section pillar-what" aria-labelledby="different-heading">
    <div class="container">
      <div class="section-with-sidebar">
        <div class="section-main">
          <p class="section-kicker">The idea</p>
          <h2 id="different-heading" class="pillar-h2">Most mentorship is designed for the organisation. This one is designed for you.</h2>
          <p class="section-intro">
            Corporate mentorship programmes exist to retain talent, manage succession, and signal that the company cares about development. The mentor has stakes in the outcome. The conversation is shaped — often invisibly — by what the organisation wants from you, not what you need for your career.
          </p>
          <p class="section-intro" style="margin-top: 1.25rem;">
            The Mentor Circle is built around a different principle. Every mentor here is agenda-free. They have no stake in where you end up. They are not your manager, not in your reporting line, not evaluating you. They are practitioners who have navigated the transition you are approaching, and they are here because they want to help — not because a programme requires them to.
          </p>
        </div>
        <aside class="section-sidebar" aria-label="Mentor Circle at a glance">
          <div class="sidebar-card">
            <p class="sidebar-card-label">Who mentors here</p>
            <ul class="sidebar-list">
              <li>Senior enterprise technology leaders</li>
              <li>Startup founders and early-stage operators</li>
              <li>Academic researchers from leading universities</li>
              <li>Peer mentors a few steps ahead of you</li>
            </ul>
          </div>
          <div class="sidebar-card sidebar-card--accent">
            <p class="sidebar-card-label">The key difference</p>
            <p class="sidebar-card-body">Agenda-free means exactly that. Your mentor has no stake in what you decide. The conversation is yours — shaped by where you want to go, not by where the organisation needs you to be.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Section 2: The four types of mentor ──────────────── -->
  <section class="pillar-section pillar-mentors bg-surface" aria-labelledby="mentor-types-heading">
    <div class="container">
      <p class="section-kicker">Who your mentor might be</p>
      <h2 id="mentor-types-heading" class="pillar-h2">Different lenses. The same commitment.</h2>

      <div class="mentor-types" role="list">

        <!-- Card 1: Enterprise Leaders -->
        <article class="mentor-type-card" role="listitem">
          <span class="mentor-type-icon" aria-hidden="true">🏢</span>
          <h3>Enterprise Leaders</h3>
          <p>Senior technology executives from large organisations in banking, fintech, insurance, and enterprise infrastructure. They understand the specific politics, complexity, and opportunity structures of operating at scale.</p>
        </article>

        <!-- Card 2: Startup Founders -->
        <article class="mentor-type-card" role="listitem">
          <span class="mentor-type-icon" aria-hidden="true">🚀</span>
          <h3>Startup Founders</h3>
          <p>Founders who have navigated the extremes of building from zero. They bring a different lens: comfort with uncertainty, speed of iteration, and the kind of pattern recognition that comes from having tried and failed and tried again.</p>
        </article>

        <!-- Card 3: Academic Researchers -->
        <article class="mentor-type-card" role="listitem">
          <span class="mentor-type-icon" aria-hidden="true">🎓</span>
          <h3>Academic Researchers</h3>
          <p>Researchers from leading academic institutions whose work intersects with the realities of technology careers — applied AI, organisational behaviour, learning science. They see the field from outside the daily pressure of it.</p>
        </article>

        <!-- Card 4: Peer Mentors -->
        <article class="mentor-type-card" role="listitem">
          <span class="mentor-type-icon" aria-hidden="true">🤝</span>
          <h3>Peer Mentors</h3>
          <p>Practitioners who are two or three steps ahead of where you are right now. Not senior enough to have forgotten what it felt like. Near enough to give you the specific, tactical guidance that comes from recent experience.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- ── Section 3: How matching works ────────────────────── -->
  <section class="pillar-section pillar-matching" aria-labelledby="matching-heading">
    <div class="container">
      <p class="section-kicker">The process</p>
      <h2 id="matching-heading" class="pillar-h2">Thoughtful matching. Not algorithmic.</h2>

      <ol class="steps-list" aria-label="How mentor matching works">

        <li class="step">
          <span class="step-num" aria-hidden="true">1</span>
          <div class="step-body">
            <h3>You tell us where you are</h3>
            <p>Your career stage, the transition you are navigating, what you are hoping to work through, and what kind of mentor relationship would be most useful for you.</p>
          </div>
        </li>

        <li class="step">
          <span class="step-num" aria-hidden="true">2</span>
          <div class="step-body">
            <h3>We match deliberately</h3>
            <p>Not based on availability or keywords. Each match is reviewed by the UpGyaan team for fit: background alignment, transition relevance, communication style, and timing.</p>
          </div>
        </li>

        <li class="step">
          <span class="step-num" aria-hidden="true">3</span>
          <div class="step-body">
            <h3>You meet regularly</h3>
            <p>Structured sessions, a defined cadence, and a clear agenda that you own. The mentor&#8217;s role is to help you think more clearly, not to tell you what to do.</p>
          </div>
        </li>

        <li class="step">
          <span class="step-num" aria-hidden="true">4</span>
          <div class="step-body">
            <h3>The relationship evolves</h3>
            <p>Many Mentor Circle relationships continue well beyond the formal programme. The formal structure creates the context; the relationship creates the value.</p>
          </div>
        </li>

      </ol>
    </div>
  </section>

  <!-- ── CTA section ───────────────────────────────────────── -->
  <section class="pillar-cta" aria-labelledby="mc-cta-heading">
    <div class="container">
      <h2 id="mc-cta-heading">Ready to find your mentor — or become one?</h2>
      <p>The Mentor Circle launches as part of our future phases. Register your interest as a member or as a mentor and we will be in touch before it opens.</p>
      <div class="cta-buttons">
        <a href="/join" class="btn-cta-primary">Register as a member</a>
        <a href="/for-mentors" class="btn-cta-ghost">Become a mentor</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .pillar-hero {
    padding: 4rem 0 3.5rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-big-icon {
    font-size: 3rem;
    line-height: 1;
  }
  .pillar-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    margin: 0;
    color: var(--color-black);
  }
  .pillar-hero-tagline {
    font-size: 1.0625rem;
    color: var(--color-text);
    max-width: 560px;
    margin: 0;
    line-height: 1.6;
  }
  .pillar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-teal);
    background: rgba(13, 115, 119, 0.08);
    border: 1px solid rgba(13, 115, 119, 0.2);
    border-radius: 20px;
    padding: 0.25rem 0.7rem;
    margin-bottom: 0.5rem;
    width: fit-content;
  }
  .pillar-breadcrumb {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    transition: color 0.15s ease;
  }
  .pillar-breadcrumb:hover,
  .pillar-breadcrumb:focus-visible {
    color: var(--color-teal);
  }
  .pillar-breadcrumb:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ── Section with sidebar layout ─────────────────────────── */
  .section-with-sidebar {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .section-with-sidebar { grid-template-columns: 1fr 280px; }
  }
  .section-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .sidebar-card--accent {
    border-left: 3px solid var(--color-teal);
    border-radius: 0 10px 10px 0;
  }
  .sidebar-card-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 0.625rem;
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sidebar-list li {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .sidebar-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-teal);
    font-size: 0.8rem;
  }
  .sidebar-card-body {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }
  a.pillar-status {
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  a.pillar-status:hover {
    background: rgba(13, 115, 119, 0.14);
    border-color: rgba(13, 115, 119, 0.4);
  }

  /* ── Section wrappers ─────────────────────────────────────── */
  .pillar-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-section:last-of-type {
    border-bottom: none;
  }
  .bg-surface {
    background: var(--color-surface);
  }

  /* ── Section typography ───────────────────────────────────── */
  .section-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
  }
  h2.pillar-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0.5rem 0 1rem;
  }
  .section-intro {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.75;
    max-width: 640px;
    margin: 0;
  }

  /* ── Mentor type 2x2 grid ─────────────────────────────────── */
  .mentor-types {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .mentor-types { grid-template-columns: repeat(2, 1fr); }
  }
  .mentor-type-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
  }
  .mentor-type-icon {
    font-size: 1.75rem;
    margin-bottom: 0.625rem;
    display: block;
  }
  .mentor-type-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }
  .mentor-type-card p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Steps ────────────────────────────────────────────────── */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2.5rem;
    list-style: none;
    padding: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .step-num {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-teal);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9375rem;
    flex-shrink: 0;
  }
  .step-body h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.375rem;
  }
  .step-body p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.75;
    margin: 0;
  }

  /* ── CTA section ──────────────────────────────────────────── */
  .pillar-cta {
    padding: 5rem 0;
    background: #0a1628;
  }
  .pillar-cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
  }
  .pillar-cta p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 0 2rem;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-amber, #F4A261);
    color: var(--color-black);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition: opacity 0.15s ease;
  }
  .btn-cta-primary:hover {
    opacity: 0.88;
  }
  .btn-cta-primary:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .btn-cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .btn-cta-ghost:hover {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }
  .btn-cta-ghost:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
