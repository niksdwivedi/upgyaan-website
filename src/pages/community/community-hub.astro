---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="Community Hub | UpGyaan"
  description="The UpGyaan Community Hub — peer groups, accountability circles, City Chapters, and Clubs for tech professionals who want to grow through community."
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="pillar-hero" aria-labelledby="community-hub-heading">
    <div class="container">
      <div class="pillar-hero-inner">
        <a href="/community" class="pillar-breadcrumb" aria-label="Back to Community">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Community
        </a>
        <p class="section-kicker">The Ecosystem — Community Hub</p>
        <div class="pillar-big-icon" aria-hidden="true">🌐</div>
        <h1 id="community-hub-heading">The Community Hub</h1>
        <p class="pillar-hero-tagline">A peer group that challenges you — not just a network</p>
        <a href="/roadmap" class="pillar-status pillar-status--active" aria-label="Status: Building now — see the roadmap">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <circle cx="5" cy="5" r="4" fill="currentColor"/>
          </svg>
          Building now — see the roadmap
        </a>
      </div>
    </div>
  </section>

  <!-- ── Section 1: The difference ────────────────────────── -->
  <section class="pillar-section pillar-what" aria-labelledby="difference-heading">
    <div class="container">
      <div class="section-with-sidebar">
        <div class="section-main">
          <p class="section-kicker">The idea</p>
          <h2 id="difference-heading" class="pillar-h2">A network is people you know. A community is people who have seen you do the work.</h2>
          <p class="section-intro">
            Professional networks are useful for broadcasting and for cold outreach. They are not built for the conversations that actually change careers — the ones where someone who knows your work gives you honest feedback, or where a peer who has just made the transition you are approaching tells you what they wish they had known.
          </p>
          <p class="section-intro section-intro--spaced">
            The difference is not the platform — it is the nature of the relationships. UpGyaan is built for the kind of community where your reputation is formed through contribution, not self-promotion. Where the person who opens a door for you does it because they have seen your work, not because you connected on LinkedIn.
          </p>
          <p class="section-intro section-intro--spaced">
            Structured peer groups, matched by career stage and context. Accountability circles small enough to create real obligation. Forums where questions get answered by people who have been there. A community you participate in, not a feed you scroll past.
          </p>
        </div>
        <aside class="section-sidebar" aria-label="Community Hub at a glance">
          <div class="sidebar-card">
            <p class="sidebar-card-label">What you get</p>
            <ul class="sidebar-list">
              <li>A small peer group that knows your work</li>
              <li>Accountability that goes beyond surface-level check-ins</li>
              <li>Access to City Chapters in your city</li>
              <li>Clubs built around shared interests</li>
            </ul>
          </div>
          <div class="sidebar-card sidebar-card--accent">
            <p class="sidebar-card-label">The key difference</p>
            <p class="sidebar-card-body">Contribution, not connection requests. The relationships that form here are grounded in work that others have actually seen — which is why they last and why they open doors.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Section 2: How the community is structured ───────── -->
  <section class="pillar-section pillar-features bg-surface" aria-labelledby="structure-heading">
    <div class="container">
      <p class="section-kicker">The structure</p>
      <h2 id="structure-heading" class="pillar-h2">Organised to create the right conditions for the right conversations</h2>

      <div class="features-grid features-grid--2x2" role="list">

        <!-- Card 1: Accountability Circles -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="5" r="2" stroke="currentColor" stroke-width="1.75"/>
              <circle cx="5"  cy="17" r="2" stroke="currentColor" stroke-width="1.75"/>
              <circle cx="19" cy="17" r="2" stroke="currentColor" stroke-width="1.75"/>
              <circle cx="5"  cy="9"  r="2" stroke="currentColor" stroke-width="1.75"/>
              <circle cx="19" cy="9"  r="2" stroke="currentColor" stroke-width="1.75"/>
              <circle cx="9"  cy="20" r="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M10 6l-4 2M14 6l4 2M7 11l2 7M17 11l-2 7M7 10h10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity="0.5"/>
            </svg>
          </div>
          <h3>Accountability Circles</h3>
          <p>Small peer groups of 6–8 members, matched by career stage and professional context. A regular cadence, structured check-ins, and the kind of accountability that only works when you actually know the people you are accountable to.</p>
        </article>

        <!-- Card 2: Structured Forums -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Structured Forums</h3>
          <p>Organised by topic, career stage, and function. Not a Slack channel that scrolls into irrelevance — a space where knowledge accumulates, answers persist, and the best contributions surface rather than disappear.</p>
        </article>

        <!-- Card 3: City Chapters -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.75"/>
            </svg>
          </div>
          <h3>City Chapters</h3>
          <p>Local communities in major tech hubs. A Chapter is your city&#8217;s UpGyaan presence — in-person meetups, workshops, peer dinners, and the Spotlight and Retreat events that bring the community off-screen. Organised by members, supported by UpGyaan.</p>
        </article>

        <!-- Card 4: Clubs -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect x="3"  y="3"  width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <rect x="13" y="3"  width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <rect x="3"  y="13" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <rect x="13" y="13" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M11 7h2M7 11v2M17 11v2M11 17h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
            </svg>
          </div>
          <h3>Clubs</h3>
          <p>Interest-based groups that cross geography and career stage. Book Club, AI Agent Club, Fitness Club, Writing Club — formed around shared curiosity, not shared location. Online by default, local when a Chapter hosts one.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- ── Section 3: City Chapters vs Clubs explained ──────── -->
  <section class="pillar-section pillar-comparison" aria-labelledby="two-ways-heading">
    <div class="container">
      <p class="section-kicker">Understanding the structure</p>
      <h2 id="two-ways-heading" class="pillar-h2">Two ways to belong. Both matter.</h2>

      <div class="comparison-grid">

        <div class="comparison-card comparison-card--chapters">
          <p class="comparison-card-label">City Chapters</p>
          <span class="comparison-card-icon" aria-hidden="true">🏙</span>
          <p class="comparison-principle">Organising principle: where you are</p>
          <h3>Rooted in place</h3>
          <p>A Chapter is a local UpGyaan community rooted in a specific city&#8217;s tech ecosystem. It provides in-person grounding for a digital community. Members join a Chapter because of where they live and work.</p>
          <p class="comparison-what">What happens: Regular meetups, workshops, peer dinners, local Spotlight sessions, and Chapter-hosted Retreats.</p>
        </div>

        <div class="comparison-card comparison-card--clubs">
          <p class="comparison-card-label">Clubs</p>
          <span class="comparison-card-icon" aria-hidden="true">🔗</span>
          <p class="comparison-principle">Organising principle: what you care about</p>
          <h3>Rooted in interest</h3>
          <p>A Club is a topic-based community that exists across geography. Clubs are online by default but can run locally when a Chapter chooses to host a session.</p>
          <p class="comparison-what">What happens: Book Club sessions, AI Agent building sessions, Fitness accountability, Writing workshops, and any interest strong enough to bring members together consistently.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Section 4: What you get ──────────────────────────── -->
  <section class="pillar-section pillar-outcomes bg-surface" aria-labelledby="hub-outcomes-heading">
    <div class="container">
      <p class="section-kicker">The outcomes</p>
      <h2 id="hub-outcomes-heading" class="pillar-h2">Contribution creates the connections that matter</h2>

      <ol class="outcomes-list" aria-label="What membership in the Community Hub gives you">
        <li class="outcome-item">
          <span class="outcome-arrow" aria-hidden="true">→</span>
          <div>
            <p><strong>A small group you trust</strong> — An accountability circle of peers who know your work, challenge your thinking, and push you forward — not because they were randomly assigned to you, but because the match was deliberate.</p>
          </div>
        </li>
        <li class="outcome-item">
          <span class="outcome-arrow" aria-hidden="true">→</span>
          <div>
            <p><strong>Relationships that create opportunity</strong> — Members who found their co-founder, their next hire, their collaborator, or their first major client through contribution in the community. Not cold outreach. Not networking events. Through doing real work alongside people who could see it.</p>
          </div>
        </li>
        <li class="outcome-item">
          <span class="outcome-arrow" aria-hidden="true">→</span>
          <div>
            <p><strong>A community identity</strong> — Being a member of a City Chapter and contributing to a Club gives you something a profile and a CV cannot: a visible, community-attested identity as someone who shows up and adds value.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── CTA section ───────────────────────────────────────── -->
  <section class="pillar-cta" aria-labelledby="hub-cta-heading">
    <div class="container">
      <h2 id="hub-cta-heading">The community is forming now.</h2>
      <p>We are in the foundation phase — the people joining now shape the culture, the norms, and the City Chapters that will form first. Register your interest and be part of what gets built.</p>
      <div class="cta-buttons">
        <a href="/join" class="btn-cta-primary">Register your interest</a>
        <a href="/roadmap" class="btn-cta-ghost">See the roadmap</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .pillar-hero {
    padding: 4rem 0 3.5rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-big-icon {
    font-size: 3rem;
    line-height: 1;
  }
  .pillar-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    margin: 0;
    color: var(--color-black);
  }
  .pillar-hero-tagline {
    font-size: 1.0625rem;
    color: var(--color-text);
    max-width: 560px;
    margin: 0;
    line-height: 1.6;
  }
  .pillar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-teal);
    background: rgba(13, 115, 119, 0.08);
    border: 1px solid rgba(13, 115, 119, 0.2);
    border-radius: 20px;
    padding: 0.25rem 0.7rem;
    margin-bottom: 0.5rem;
    width: fit-content;
  }
  .pillar-status--active {
    color: #92620A;
    background: rgba(249, 168, 37, 0.12);
    border-color: rgba(249, 168, 37, 0.35);
  }
  .pillar-breadcrumb {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    transition: color 0.15s ease;
  }
  .pillar-breadcrumb:hover,
  .pillar-breadcrumb:focus-visible {
    color: var(--color-teal);
  }
  .pillar-breadcrumb:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ── Section with sidebar layout ─────────────────────────── */
  .section-with-sidebar {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .section-with-sidebar { grid-template-columns: 1fr 280px; }
  }
  .section-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .sidebar-card--accent {
    border-left: 3px solid var(--color-teal);
    border-radius: 0 10px 10px 0;
  }
  .sidebar-card-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 0.625rem;
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sidebar-list li {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .sidebar-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-teal);
    font-size: 0.8rem;
  }
  .sidebar-card-body {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }
  a.pillar-status {
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  a.pillar-status:hover {
    background: rgba(249, 168, 37, 0.2);
    border-color: rgba(249, 168, 37, 0.5);
  }

  /* ── Section wrappers ─────────────────────────────────────── */
  .pillar-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-section:last-of-type {
    border-bottom: none;
  }
  .bg-surface {
    background: var(--color-surface);
  }

  /* ── Section typography ───────────────────────────────────── */
  .section-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
  }
  h2.pillar-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0.5rem 0 1rem;
  }
  .section-intro {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.75;
    max-width: 640px;
    margin: 0;
  }
  .section-intro--spaced {
    margin-top: 1.25rem;
  }

  /* ── Feature grid ─────────────────────────────────────────── */
  .features-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .feature-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .feature-card:focus-within {
    border-color: var(--color-teal);
  }
  .feature-icon {
    margin-bottom: 0.875rem;
    color: var(--color-teal);
  }
  .feature-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }
  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Comparison grid ──────────────────────────────────────── */
  .comparison-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .comparison-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .comparison-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.75rem;
  }
  .comparison-card--chapters {
    border-top: 3px solid var(--color-teal);
  }
  .comparison-card--clubs {
    border-top: 3px solid var(--color-amber);
  }
  .comparison-card-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 0.375rem;
  }
  .comparison-card-icon {
    font-size: 2rem;
    margin: 0.375rem 0 0.875rem;
    display: block;
  }
  .comparison-principle {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    font-style: italic;
    margin: 0 0 1rem;
  }
  .comparison-card h3 {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.625rem;
  }
  .comparison-card p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .comparison-card p:last-child {
    margin-bottom: 0;
  }
  .comparison-what {
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-style: italic;
  }

  /* ── Outcomes list ────────────────────────────────────────── */
  .outcomes-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
    list-style: none;
    padding: 0;
  }
  .outcome-item {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.875rem;
    align-items: start;
  }
  .outcome-arrow {
    color: var(--color-teal);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.75;
  }
  .outcome-item strong {
    color: var(--color-black);
  }
  .outcome-item p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.75;
    margin: 0;
  }

  /* ── CTA section ──────────────────────────────────────────── */
  .pillar-cta {
    padding: 5rem 0;
    background: #0a1628;
  }
  .pillar-cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
  }
  .pillar-cta p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 0 2rem;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-amber);
    color: var(--color-black);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition: opacity 0.15s ease;
  }
  .btn-cta-primary:hover {
    opacity: 0.88;
    color: var(--color-black);
  }
  .btn-cta-primary:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .btn-cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .btn-cta-ghost:hover {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }
  .btn-cta-ghost:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
