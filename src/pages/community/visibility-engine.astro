---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="Visibility Engine | UpGyaan"
  description="The UpGyaan Visibility Engine — turn your expertise into a professional footprint that gets noticed. Blogs, open-source, white papers, and showcasable outcomes."
>

  <!-- ── Hero ───────────────────────────────────────────── -->
  <section class="pillar-hero" aria-labelledby="ve-heading">
    <div class="container">
      <a href="/community" class="pillar-breadcrumb">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Community
      </a>
      <div class="pillar-hero-inner">
        <p class="section-kicker">The Ecosystem — Visibility Engine</p>
        <div class="pillar-big-icon" aria-hidden="true">👁</div>
        <h1 id="ve-heading">The Visibility Engine</h1>
        <p class="pillar-hero-tagline">Showcasable outcomes that outlast any single role</p>
        <a href="/roadmap" class="pillar-status" aria-label="Status: Coming in a future phase — see the roadmap">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5 3v2l1.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Coming in a future phase — see the roadmap
        </a>
      </div>
    </div>
  </section>

  <!-- ── Section 1: The problem ─────────────────────────── -->
  <section class="pillar-section" aria-labelledby="ve-problem-heading">
    <div class="container">
      <div class="section-with-sidebar">
        <div class="section-main">
          <p class="section-kicker">The visibility gap</p>
          <h2 id="ve-problem-heading" class="pillar-h2">Great work that nobody sees is a career risk, not a virtue</h2>
          <div class="prose-block">
            <p>
              The assumption that good work will be noticed — that if you deliver well enough and long enough, recognition will follow — is one of the most costly beliefs in tech careers. It was questionable before AI. Now, in a world where the output of any individual contributor can be replicated or augmented, what cannot be replicated is your track record of judgment, your pattern of contribution, and the community that has witnessed it.
            </p>
            <p>
              Visibility is not self-promotion. It is the professional infrastructure that makes your expertise discoverable to the people and opportunities that matter. The Visibility Engine is how UpGyaan helps you build that infrastructure — not by creating content for its own sake, but by turning the work you are already doing into something that travels further than your team.
            </p>
          </div>
        </div>
        <aside class="section-sidebar" aria-label="Visibility Engine at a glance">
          <div class="sidebar-card">
            <p class="sidebar-card-label">What makes it real</p>
            <ul class="sidebar-list">
              <li>Community peers review your contributions</li>
              <li>Mentors validate quality before amplification</li>
              <li>Reviewers add context and endorsement</li>
              <li>Work is attributed and indexed under your name</li>
            </ul>
          </div>
          <div class="sidebar-card sidebar-card--accent">
            <p class="sidebar-card-label">The principle</p>
            <p class="sidebar-card-body">Visibility earned through community attestation means something. A blog post endorsed by your peers and mentors carries more weight than one posted alone — because the reader knows it has been seen, challenged, and found worthy.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Section 2: What counts as visible work ─────────── -->
  <section class="pillar-section bg-surface" aria-labelledby="ve-forms-heading">
    <div class="container">
      <p class="section-kicker">The forms</p>
      <h2 id="ve-forms-heading" class="pillar-h2">Contribution that compounds</h2>
      <div class="features-grid">

        <!-- Card 1: UpGyaan Blog -->
        <article class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="4" y="3" width="20" height="22" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <path d="M9 9h10M9 13h10M9 17h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>The UpGyaan Blog</h3>
          <p>Articles, perspectives, and technical deep-dives published under your name. Community members review drafts and add their perspective. Mentors provide editorial input. The result is work that carries more weight because the community stood behind it.</p>
        </article>

        <!-- Card 2: Open-Source Contributions -->
        <article class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="14" cy="6" r="3" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="6" cy="22" r="3" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="22" cy="22" r="3" stroke="currentColor" stroke-width="1.5"/>
              <path d="M14 9v4M14 13l-5 6M14 13l5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Open-Source Contributions</h3>
          <p>Verifiable, public-facing technical work. Community reviewers and mentors with open-source experience provide code review, context, and endorsement — turning a solo contribution into a community-attested one.</p>
        </article>

        <!-- Card 3: White Papers & Research -->
        <article class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="4" y="3" width="20" height="22" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <path d="M9 9h10M9 13h10M9 17h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="21" cy="21" r="5" fill="var(--color-surface)" stroke="currentColor" stroke-width="1.5"/>
              <path d="M19 21h4M21 19v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>White Papers &amp; Research</h3>
          <p>Deeper analytical work co-developed with academic mentors and peer reviewers. Research collaborations that would not happen without the community — and work that gets cited because the names behind it are credible.</p>
        </article>

        <!-- Card 4: Capstone Projects -->
        <article class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="4" y="4" width="20" height="20" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <path d="M14 8v12M8 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M10 10l8 8M18 10l-8 8" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.3"/>
              <circle cx="14" cy="14" r="3" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3>Capstone Projects</h3>
          <p>Structured outcome projects tied to the Academy curriculum. Mentors guide the brief, peers review the output, and the community signs off on quality — so what gets published is work that has genuinely been tested, not just submitted.</p>
        </article>

        <!-- Card 5: Cross-Platform Amplification -->
        <article class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M5 14c0-1 .5-2 1.5-2.5L20 5l-3 13.5c-.3 1.2-1.7 1.7-2.7 1L11 17l-3 3-1-4-3-1.5C4.5 14 4.5 14 5 14z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Cross-Platform Amplification</h3>
          <p>When the community validates your work, UpGyaan amplifies it across LinkedIn, X, and YouTube. The amplification is a community endorsement — carrying the credibility of everyone who reviewed and contributed to it, not just you.</p>
        </article>

        <!-- Card 6: Showcase Champion -->
        <article class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 4l2.5 5 5.5.8-4 3.9 1 5.5L14 16.7l-5 2.5 1-5.5L6 9.8l5.5-.8L14 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M10 23h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M14 19v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Showcase Champion</h3>
          <p>Each period, the community — peers, reviewers, and mentors collectively — recognises a Showcase Champion: the member whose contribution best exemplifies the quality and generosity that define UpGyaan. A recognition that means something because the community grants it, not a platform.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- ── Section 3: How it works ────────────────────────── -->
  <section class="pillar-section" aria-labelledby="ve-process-heading">
    <div class="container">
      <p class="section-kicker">The process</p>
      <h2 id="ve-process-heading" class="pillar-h2">From work to footprint in four steps</h2>
      <ol class="steps-list" role="list">
        <li class="step">
          <div class="step-num" aria-hidden="true">1</div>
          <div class="step-body">
            <h3>You do the work</h3>
            <p>A blog post, a contribution, a project, a paper. The Visibility Engine starts with something real — not manufactured content, but work that reflects genuine expertise or genuine curiosity.</p>
          </div>
        </li>
        <li class="step">
          <div class="step-num" aria-hidden="true">2</div>
          <div class="step-body">
            <h3>The community reviews it</h3>
            <p>Other members read it, respond to it, build on it. The best contributions surface through community engagement, not editorial gatekeeping.</p>
          </div>
        </li>
        <li class="step">
          <div class="step-num" aria-hidden="true">3</div>
          <div class="step-body">
            <h3>UpGyaan amplifies it</h3>
            <p>Contributions that meet the quality bar are amplified across platforms — attributed, promoted, and indexed as part of your growing professional record.</p>
          </div>
        </li>
        <li class="step">
          <div class="step-num" aria-hidden="true">4</div>
          <div class="step-body">
            <h3>It compounds</h3>
            <p>Each visible contribution raises the profile of the ones that follow. The second piece lands with more authority than the first. The fifth opens doors the first could not.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────── -->
  <section class="pillar-cta" aria-labelledby="ve-cta-heading">
    <div class="container">
      <h2 id="ve-cta-heading">Start building your professional footprint.</h2>
      <p>The Visibility Engine launches as part of our future phases, but you can start contributing right now — through the UpGyaan blog and community. Register your interest and be among the first to access the full platform.</p>
      <div class="cta-buttons">
        <a href="/join" class="btn-primary">Register your interest</a>
        <a href="/blog" class="btn-secondary-light">Read the blog</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .pillar-hero {
    padding: 4rem 0 3.5rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-big-icon {
    font-size: 3rem;
    line-height: 1;
  }
  .pillar-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    margin: 0;
    font-family: var(--font-heading);
    color: var(--color-black);
  }
  .pillar-hero-tagline {
    font-size: 1.0625rem;
    color: var(--color-text);
    max-width: 560px;
    margin: 0;
    line-height: 1.6;
  }
  .pillar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-teal);
    background: rgba(13, 115, 119, 0.08);
    border: 1px solid rgba(13, 115, 119, 0.2);
    border-radius: 20px;
    padding: 0.25rem 0.7rem;
    margin-bottom: 0.5rem;
    width: fit-content;
  }
  .pillar-breadcrumb {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }
  .pillar-breadcrumb:hover,
  .pillar-breadcrumb:focus-visible {
    color: var(--color-teal);
  }
  .pillar-breadcrumb:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ── Section with sidebar layout ─────────────────────────── */
  .section-with-sidebar {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .section-with-sidebar { grid-template-columns: 1fr 280px; }
  }
  .section-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .sidebar-card--accent {
    border-left: 3px solid var(--color-teal);
    border-radius: 0 10px 10px 0;
  }
  .sidebar-card-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 0.625rem;
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sidebar-list li {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .sidebar-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-teal);
    font-size: 0.8rem;
  }
  .sidebar-card-body {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }
  a.pillar-status {
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  a.pillar-status:hover {
    background: rgba(13, 115, 119, 0.14);
    border-color: rgba(13, 115, 119, 0.4);
  }

  /* ── Sections ─────────────────────────────────────────── */
  .pillar-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .bg-surface {
    background: var(--color-surface);
  }
  .section-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
  }
  h2.pillar-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0.5rem 0 1rem;
  }
  .prose-block {
    max-width: 760px;
  }
  .prose-block p {
    font-size: 1.0625rem;
    color: var(--color-text);
    line-height: 1.8;
    margin: 0 0 1.25rem;
  }
  .prose-block p:last-child {
    margin-bottom: 0;
  }

  /* ── Features grid ────────────────────────────────────── */
  .features-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .features-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .feature-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
  }
  .feature-icon {
    margin-bottom: 0.875rem;
    color: var(--color-teal);
  }
  .feature-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }
  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Steps list ───────────────────────────────────────── */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2.5rem;
    padding: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .step-num {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-teal);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9375rem;
    flex-shrink: 0;
  }
  .step-body h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.375rem;
  }
  .step-body p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.75;
    margin: 0;
  }

  /* ── CTA ──────────────────────────────────────────────── */
  .pillar-cta {
    padding: 5rem 0;
    background: #0a1628;
  }
  .pillar-cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
  }
  .pillar-cta p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 0 2rem;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .btn-secondary-light {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.375rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: var(--font-body);
    text-decoration: none;
    color: #fff;
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .btn-secondary-light:hover,
  .btn-secondary-light:focus-visible {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.07);
  }
  .btn-secondary-light:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ── Accessibility ────────────────────────────────────── */
  :focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
