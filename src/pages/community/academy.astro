---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="Academy | UpGyaan"
  description="The UpGyaan Academy — career frameworks built for real tech career transitions, not generic online courses."
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="pillar-hero" aria-labelledby="academy-heading">
    <div class="container">
      <div class="pillar-hero-inner">
        <a href="/community" class="pillar-breadcrumb" aria-label="Back to Community">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Community
        </a>
        <p class="section-kicker">The Ecosystem — Academy</p>
        <div class="pillar-big-icon" aria-hidden="true">🎓</div>
        <h1 id="academy-heading">The Academy</h1>
        <p class="pillar-hero-tagline">Career frameworks built for real transitions — not generic courses</p>
        <a href="/roadmap" class="pillar-status" aria-label="Status: Coming in a future phase — see the roadmap">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Coming in a future phase — see the roadmap
        </a>
      </div>
    </div>
  </section>

  <!-- ── Section 1: What it is ────────────────────────────── -->
  <section class="pillar-section pillar-what" aria-labelledby="what-heading">
    <div class="container">
      <div class="section-with-sidebar">
        <div class="section-main">
          <p class="section-kicker">The idea</p>
          <h2 id="what-heading" class="pillar-h2">Career growth in tech has a curriculum problem</h2>
          <p class="section-intro">
            Most online learning for tech professionals solves the wrong problem. Courses teach tools and frameworks — they rarely address the decisions that actually define a career: how to build upward influence, how to navigate a promotion cycle, how to make the IC-to-manager transition without losing what made you good, how to communicate at the executive level when you have never had to before.
          </p>
          <p class="section-intro" style="margin-top: 1.25rem;">
            The Academy is UpGyaan&#8217;s answer to that gap. Not a library of content — a structured, community-informed curriculum built around the specific inflection points that tech professionals face at every stage of their career.
          </p>
        </div>
        <aside class="section-sidebar" aria-label="Academy at a glance">
          <div class="sidebar-card">
            <p class="sidebar-card-label">Who it is for</p>
            <ul class="sidebar-list">
              <li>Developers targeting architecture or staff-level roles</li>
              <li>ICs moving into leadership for the first time</li>
              <li>Mid-career professionals whose trajectory has stalled</li>
              <li>Senior leaders preparing for executive transition</li>
            </ul>
          </div>
          <div class="sidebar-card sidebar-card--accent">
            <p class="sidebar-card-label">How it differs</p>
            <p class="sidebar-card-body">Not courses to complete — frameworks to apply. Every track is built around a real career decision, not a certificate to add to your LinkedIn.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Section 2: What the Academy covers ───────────────── -->
  <section class="pillar-section pillar-features bg-surface" aria-labelledby="curriculum-heading">
    <div class="container">
      <p class="section-kicker">The curriculum</p>
      <h2 id="curriculum-heading" class="pillar-h2">Built for inflection points, not job titles</h2>

      <div class="features-grid" role="list">

        <!-- Card 1: IC to Lead -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>IC to Lead</h3>
          <p>From individual contributor to tech lead — managing complexity, earning influence, and navigating the politics of being new to leadership without a formal title.</p>
        </article>

        <!-- Card 2: Lead to Manager -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="5" r="2.5" stroke="currentColor" stroke-width="1.75"/>
              <circle cx="5" cy="17" r="2.5" stroke="currentColor" stroke-width="1.75"/>
              <circle cx="19" cy="17" r="2.5" stroke="currentColor" stroke-width="1.75"/>
              <path d="M12 7.5v4M12 11.5l-5 3M12 11.5l5 3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Lead to Manager</h3>
          <p>The hardest transition in tech. From being the best individual to building a team that is collectively better. Delegation, feedback culture, performance conversations.</p>
        </article>

        <!-- Card 3: Senior to Executive -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M12 3L4 20h16L12 3z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M12 10v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="12" cy="17" r="0.75" fill="currentColor"/>
            </svg>
          </div>
          <h3>Senior to Executive</h3>
          <p>From being great at your function to operating at the strategic level. Executive communication, stakeholder management, and building an agenda beyond your immediate remit.</p>
        </article>

        <!-- Card 4: Developer to Architect -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="3" width="8" height="6" rx="1.5" stroke="currentColor" stroke-width="1.75"/>
              <rect x="14" y="3" width="8" height="6" rx="1.5" stroke="currentColor" stroke-width="1.75"/>
              <rect x="8" y="15" width="8" height="6" rx="1.5" stroke="currentColor" stroke-width="1.75"/>
              <path d="M6 9v3M18 9v3M6 12h12M12 12v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Developer to Architect</h3>
          <p>From writing code to designing systems that others build. Thinking at the architecture level, earning technical authority, influencing decisions without being the one who writes every line.</p>
        </article>

        <!-- Card 5: Promotion Cycles -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/>
              <path d="M12 12l3-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="12" cy="12" r="1.25" fill="currentColor"/>
              <path d="M12 4v1M12 19v1M4 12h1M19 12h1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Promotion Cycles</h3>
          <p>How to navigate the performance review process with intention — building the evidence, framing the narrative, and managing the timeline before the conversation happens.</p>
        </article>

        <!-- Card 6: AI-Era Navigation -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M12 2a4 4 0 014 4c0 1.5-.8 2.8-2 3.46V12h-4V9.46A4 4 0 0112 2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M10 12H8a2 2 0 00-2 2v2a2 2 0 002 2h8a2 2 0 002-2v-2a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M9 18v2M15 18v2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>AI-Era Navigation</h3>
          <p>Building a career in a world being actively reshaped by AI — where to focus, what skills remain durable, and how to position yourself ahead of the disruption rather than after it.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- ── Section 3: How it works ──────────────────────────── -->
  <section class="pillar-section pillar-how" aria-labelledby="format-heading">
    <div class="container">
      <p class="section-kicker">The format</p>
      <h2 id="format-heading" class="pillar-h2">Learning that fits around work — not the other way around</h2>

      <ol class="steps-list" aria-label="How the Academy works">

        <li class="step">
          <span class="step-num" aria-hidden="true">1</span>
          <div class="step-body">
            <h3>Structured tracks</h3>
            <p>Each career inflection point has its own track: a sequence of frameworks, case studies, and practitioner inputs curated by the community. You choose the track that matches where you are.</p>
          </div>
        </li>

        <li class="step">
          <span class="step-num" aria-hidden="true">2</span>
          <div class="step-body">
            <h3>Live webinars</h3>
            <p>Regular sessions with practitioners who have made the transition you are approaching. Not lecture format — structured conversations with real questions from the community.</p>
          </div>
        </li>

        <li class="step">
          <span class="step-num" aria-hidden="true">3</span>
          <div class="step-body">
            <h3>Community-refined curriculum</h3>
            <p>The Academy curriculum is not fixed. It is continuously updated based on what the community is actually wrestling with — surfaced through AI Insights and community discussion.</p>
          </div>
        </li>

      </ol>
    </div>
  </section>

  <!-- ── CTA section ───────────────────────────────────────── -->
  <section class="pillar-cta" aria-labelledby="academy-cta-heading">
    <div class="container">
      <h2 id="academy-cta-heading">Be among the first when the Academy opens.</h2>
      <p>The Academy launches as part of our future phases. Register your interest now and be first to know when it opens — and help shape what it covers.</p>
      <div class="cta-buttons">
        <a href="/join" class="btn-cta-primary">Register your interest</a>
        <a href="/roadmap" class="btn-cta-ghost">See the roadmap</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .pillar-hero {
    padding: 4rem 0 3.5rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-big-icon {
    font-size: 3rem;
    line-height: 1;
  }
  .pillar-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    margin: 0;
    color: var(--color-black);
  }
  .pillar-hero-tagline {
    font-size: 1.0625rem;
    color: var(--color-text);
    max-width: 560px;
    margin: 0;
    line-height: 1.6;
  }
  .pillar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-teal);
    background: rgba(13, 115, 119, 0.08);
    border: 1px solid rgba(13, 115, 119, 0.2);
    border-radius: 20px;
    padding: 0.25rem 0.7rem;
    margin-bottom: 0.5rem;
    width: fit-content;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  a.pillar-status:hover {
    background: rgba(13, 115, 119, 0.14);
    border-color: rgba(13, 115, 119, 0.4);
  }
  .pillar-breadcrumb {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    transition: color 0.15s ease;
  }
  .pillar-breadcrumb:hover,
  .pillar-breadcrumb:focus-visible {
    color: var(--color-teal);
  }
  .pillar-breadcrumb:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ── Section with sidebar layout ─────────────────────────── */
  .section-with-sidebar {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .section-with-sidebar { grid-template-columns: 1fr 280px; }
  }
  .section-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .sidebar-card--accent {
    border-left: 3px solid var(--color-teal);
    border-radius: 0 10px 10px 0;
  }
  .sidebar-card-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 0.625rem;
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sidebar-list li {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .sidebar-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-teal);
    font-size: 0.8rem;
  }
  .sidebar-card-body {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Section wrappers ─────────────────────────────────────── */
  .pillar-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-section:last-of-type {
    border-bottom: none;
  }
  .bg-surface {
    background: var(--color-surface);
  }

  /* ── Section typography ───────────────────────────────────── */
  .section-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
  }
  h2.pillar-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0.5rem 0 1rem;
  }
  .section-intro {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.75;
    max-width: 640px;
    margin: 0;
  }

  /* ── Feature grid ─────────────────────────────────────────── */
  .features-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .features-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .feature-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .feature-card:focus-within {
    border-color: var(--color-teal);
  }
  .feature-icon {
    margin-bottom: 0.875rem;
    color: var(--color-teal);
  }
  .feature-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }
  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Steps ────────────────────────────────────────────────── */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2.5rem;
    list-style: none;
    padding: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .step-num {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-teal);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9375rem;
    flex-shrink: 0;
  }
  .step-body h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.375rem;
  }
  .step-body p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.75;
    margin: 0;
  }

  /* ── CTA section ──────────────────────────────────────────── */
  .pillar-cta {
    padding: 5rem 0;
    background: #0a1628;
  }
  .pillar-cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
  }
  .pillar-cta p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 0 2rem;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-amber, #F4A261);
    color: var(--color-black);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition: opacity 0.15s ease;
  }
  .btn-cta-primary:hover {
    opacity: 0.88;
  }
  .btn-cta-primary:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .btn-cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .btn-cta-ghost:hover {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }
  .btn-cta-ghost:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
