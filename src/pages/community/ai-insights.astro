---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="AI Insights | UpGyaan"
  description="UpGyaan AI Insights — community-powered career intelligence, not generic AI advice. Built on real career patterns from the community."
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="pillar-hero" aria-labelledby="ai-insights-heading">
    <div class="container">
      <div class="pillar-hero-inner">
        <a href="/community" class="pillar-breadcrumb" aria-label="Back to Community">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Community
        </a>
        <p class="section-kicker">The Ecosystem — AI Insights</p>
        <div class="pillar-big-icon" aria-hidden="true">🤖</div>
        <h1 id="ai-insights-heading">AI Insights</h1>
        <p class="pillar-hero-tagline">Not artificially intelligent — community signal, not generic advice</p>
        <a href="/roadmap" class="pillar-status" aria-label="Status: Coming in a future phase — see the roadmap">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Coming in a future phase — see the roadmap
        </a>
      </div>
    </div>
  </section>

  <!-- ── Section 1: What it is ────────────────────────────── -->
  <section class="pillar-section pillar-what" aria-labelledby="not-chatbot-heading">
    <div class="container">
      <div class="section-with-sidebar">
        <div class="section-main">
          <p class="section-kicker">The idea</p>
          <h2 id="not-chatbot-heading" class="pillar-h2">Not artificial intelligence. Community intelligence.</h2>
          <p class="section-intro">
            Most career advice is generic — because it is built on generic data. Ask any AI tool what you should do to get promoted and it will give you the same answer it gives everyone. That is not guidance. That is noise with good grammar.
          </p>
          <p class="section-intro section-intro--spaced">
            AI Insights is built on something different: the collective experience of real people who have navigated the same transitions you are approaching. It watches your trajectory within the UpGyaan community — what you are working on, what your peers and mentors observe, how your contributions are received — and surfaces intelligence about where to focus next.
          </p>
          <p class="section-intro section-intro--spaced">
            Think of it as having a mentor who has seen hundreds of careers at your exact stage, and who is always watching — not to judge, but to spot the patterns that indicate what your next move should be before you have to ask.
          </p>
        </div>
        <aside class="section-sidebar" aria-label="AI Insights at a glance">
          <div class="sidebar-card">
            <p class="sidebar-card-label">What makes it different</p>
            <ul class="sidebar-list">
              <li>Built on community patterns, not generic data</li>
              <li>Validated by mentors who know your context</li>
              <li>Specific to your career stage and trajectory</li>
              <li>Gets smarter as the community grows</li>
            </ul>
          </div>
          <div class="sidebar-card sidebar-card--accent">
            <p class="sidebar-card-label">The principle</p>
            <p class="sidebar-card-body">The best career advice has always come from people who have been there. AI Insights is how we make that advice available to every member — not just the ones lucky enough to know the right person.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Section 2: Three components ─────────────────────── -->
  <section class="pillar-section pillar-features bg-surface" aria-labelledby="three-layers-heading">
    <div class="container">
      <p class="section-kicker">How it works</p>
      <h2 id="three-layers-heading" class="pillar-h2">Three layers of community intelligence</h2>

      <div class="features-grid" role="list">

        <!-- Card 1: Signal Extraction -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M4 6h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="8" cy="6" r="1.75" fill="currentColor" stroke="none"/>
              <path d="M4 12h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="16" cy="12" r="1.75" fill="currentColor" stroke="none"/>
              <path d="M4 18h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="11" cy="18" r="1.75" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <h3>Community Pattern Recognition</h3>
          <p>Community discussions, mentor conversations, and member outcomes are analysed to identify patterns that actually predict career progress — what works at this stage, in this sector, for this kind of transition. Signal from people who have been there, not from averages.</p>
        </article>

        <!-- Card 2: Skill & Growth Matrix -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <polygon points="12,3 20,8 20,16 12,21 4,16 4,8" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" fill="none"/>
              <polygon points="12,7 17,10 17,14 12,17 7,14 7,10" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" fill="none" opacity="0.45"/>
              <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
            </svg>
          </div>
          <h3>Skill &amp; Growth Matrix</h3>
          <p>A dynamic map of your strengths, gaps, and trajectory — built from your contributions and interactions, not a self-assessment form. Tracks where you are going, not just where you are.</p>
        </article>

        <!-- Card 3: Mentor-Validated Recommendations -->
        <article class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle cx="9" cy="7" r="3.5" stroke="currentColor" stroke-width="1.75"/>
              <path d="M2 20c0-3.5 3.1-6 7-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="17" cy="15" r="4" stroke="currentColor" stroke-width="1.75"/>
              <path d="M15 15l1.5 1.5 2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Mentor-Validated Recommendations</h3>
          <p>Every recommendation is reviewed against mentor input before surfacing to members. The AI finds the pattern; the mentors validate whether it applies to someone in your specific situation.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- ── Section 3: What you get ──────────────────────────── -->
  <section class="pillar-section pillar-outcomes" aria-labelledby="outcomes-heading">
    <div class="container">
      <p class="section-kicker">The output</p>
      <h2 id="outcomes-heading" class="pillar-h2">Clarity on your highest-leverage next moves</h2>

      <ol class="outcomes-list" aria-label="What AI Insights gives you">
        <li class="outcome-item">
          <span class="outcome-arrow" aria-hidden="true">→</span>
          <div>
            <p><strong>Where to focus</strong> — Your specific development priorities at this moment in your career — not a generic list of skills to acquire, but the specific capabilities that would most change your trajectory right now.</p>
          </div>
        </li>
        <li class="outcome-item">
          <span class="outcome-arrow" aria-hidden="true">→</span>
          <div>
            <p><strong>What to build</strong> — The projects, contributions, and visible work that would most strengthen your profile for the transition you are approaching — informed by what has worked for members who have made that transition before you.</p>
          </div>
        </li>
        <li class="outcome-item">
          <span class="outcome-arrow" aria-hidden="true">→</span>
          <div>
            <p><strong>Who to talk to</strong> — Connections within the community whose experience is most relevant to your current situation — surfaced by pattern, not algorithm.</p>
          </div>
        </li>
        <li class="outcome-item">
          <span class="outcome-arrow" aria-hidden="true">→</span>
          <div>
            <p><strong>When to move</strong> — Timing intelligence: when your current role has given you what it can give, and when the conditions are right to make your next move.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── CTA section ───────────────────────────────────────── -->
  <section class="pillar-cta" aria-labelledby="ai-insights-cta-heading">
    <div class="container">
      <h2 id="ai-insights-cta-heading">Be among the first when AI Insights launches.</h2>
      <p>AI Insights launches as part of our future phases — built on the signal generated by the community we are forming now. Register your interest and help shape what it prioritises.</p>
      <div class="cta-buttons">
        <a href="/join" class="btn-cta-primary">Register your interest</a>
        <a href="/roadmap" class="btn-cta-ghost">See the roadmap</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .pillar-hero {
    padding: 4rem 0 3.5rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-big-icon {
    font-size: 3rem;
    line-height: 1;
  }
  .pillar-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    margin: 0;
    color: var(--color-black);
  }
  .pillar-hero-tagline {
    font-size: 1.0625rem;
    color: var(--color-text);
    max-width: 560px;
    margin: 0;
    line-height: 1.6;
  }
  .pillar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-teal);
    background: rgba(13, 115, 119, 0.08);
    border: 1px solid rgba(13, 115, 119, 0.2);
    border-radius: 20px;
    padding: 0.25rem 0.7rem;
    margin-bottom: 0.5rem;
    width: fit-content;
  }
  .pillar-breadcrumb {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    transition: color 0.15s ease;
  }
  .pillar-breadcrumb:hover,
  .pillar-breadcrumb:focus-visible {
    color: var(--color-teal);
  }
  .pillar-breadcrumb:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* ── Section with sidebar layout ─────────────────────────── */
  .section-with-sidebar {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .section-with-sidebar { grid-template-columns: 1fr 280px; }
  }
  .section-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .sidebar-card--accent {
    border-left: 3px solid var(--color-teal);
    border-radius: 0 10px 10px 0;
  }
  .sidebar-card-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 0.625rem;
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sidebar-list li {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .sidebar-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-teal);
    font-size: 0.8rem;
  }
  .sidebar-card-body {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }
  a.pillar-status {
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  a.pillar-status:hover {
    background: rgba(13, 115, 119, 0.14);
    border-color: rgba(13, 115, 119, 0.4);
  }

  /* ── Section wrappers ─────────────────────────────────────── */
  .pillar-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pillar-section:last-of-type {
    border-bottom: none;
  }
  .bg-surface {
    background: var(--color-surface);
  }

  /* ── Section typography ───────────────────────────────────── */
  .section-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
  }
  h2.pillar-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0.5rem 0 1rem;
  }
  .section-intro {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.75;
    max-width: 640px;
    margin: 0;
  }
  .section-intro--spaced {
    margin-top: 1.25rem;
  }

  /* ── Feature grid ─────────────────────────────────────────── */
  .features-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .features-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .feature-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .feature-card:focus-within {
    border-color: var(--color-teal);
  }
  .feature-icon {
    margin-bottom: 0.875rem;
    color: var(--color-teal);
  }
  .feature-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }
  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Outcomes list ────────────────────────────────────────── */
  .outcomes-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
    list-style: none;
    padding: 0;
  }
  .outcome-item {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.875rem;
    align-items: start;
  }
  .outcome-arrow {
    color: var(--color-teal);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.75;
  }
  .outcome-item strong {
    color: var(--color-black);
  }
  .outcome-item p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.75;
    margin: 0;
  }

  /* ── CTA section ──────────────────────────────────────────── */
  .pillar-cta {
    padding: 5rem 0;
    background: #0a1628;
  }
  .pillar-cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
  }
  .pillar-cta p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 0 2rem;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-amber);
    color: var(--color-black);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition: opacity 0.15s ease;
  }
  .btn-cta-primary:hover {
    opacity: 0.88;
    color: var(--color-black);
  }
  .btn-cta-primary:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .btn-cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .btn-cta-ghost:hover {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }
  .btn-cta-ghost:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
