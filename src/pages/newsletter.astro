---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
---

<BaseLayout
  title="Newsletter"
  description="The UpGyaan weekly — one email with insights on careers, tech, mentorship, and growth. No fluff. Written by practitioners."
>

  <section class="newsletter-hero" aria-labelledby="newsletter-heading">
    <div class="container">
      <div class="newsletter-inner">
        <div class="newsletter-text">
          <p class="newsletter-label" aria-hidden="true">Weekly newsletter</p>
          <h1 id="newsletter-heading">The UpGyaan weekly</h1>
          <p class="newsletter-value-prop">
            One email a week. Insights on careers, tech, mentorship, and growth — written by practitioners, not content mills. No fluff. Unsubscribe in one click.
          </p>

          <ul class="newsletter-features" aria-label="What you'll receive">
            <li>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4 9l4 4 6-7" stroke="#0D7377" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Career growth strategies that work in the real world
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4 9l4 4 6-7" stroke="#0D7377" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Mentorship insights from senior leaders
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4 9l4 4 6-7" stroke="#0D7377" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Visibility and personal brand frameworks
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4 9l4 4 6-7" stroke="#0D7377" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Community updates and what we're building next
            </li>
          </ul>
        </div>

        <div class="newsletter-form-card">
          <h2 class="form-card-heading">Get the weekly in your inbox</h2>
          <EmailCapture id="newsletter" context="newsletter" />
          <p class="newsletter-reassurance">
            No spam. No selling your email. Just signal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof / context -->
  <section class="newsletter-why" aria-labelledby="why-heading">
    <div class="container">
      <h2 id="why-heading" class="why-heading">Why practitioners, not content mills?</h2>
      <div class="why-grid">
        <div class="why-card">
          <h3>Written from the inside</h3>
          <p>Every piece of content in the UpGyaan weekly comes from someone who has lived the career transitions they are writing about. Not theory — experience.</p>
        </div>
        <div class="why-card">
          <h3>One idea, done properly</h3>
          <p>We do not send you five things you probably already knew. We pick one idea that is worth your time and develop it properly. You read it in five minutes. It stays with you longer.</p>
        </div>
        <div class="why-card">
          <h3>No algorithm, no noise</h3>
          <p>Your inbox is not a feed. The UpGyaan weekly lands at the same time every week, has the same purpose, and treats your time as the scarce resource it is.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .newsletter-hero {
    padding: 5rem 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .newsletter-inner {
    display: grid;
    gap: 3rem;
    align-items: flex-start;
  }

  @media (min-width: 1024px) {
    .newsletter-inner {
      grid-template-columns: 1fr 420px;
    }
  }

  .newsletter-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
  }

  .newsletter-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 1.25rem;
  }

  .newsletter-value-prop {
    font-size: 1.0625rem;
    color: var(--color-text);
    line-height: 1.75;
    max-width: 520px;
    margin: 0 0 2rem;
  }

  .newsletter-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .newsletter-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .newsletter-features svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /* Form card */
  .newsletter-form-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
  }

  .form-card-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 1.25rem;
  }

  .newsletter-reassurance {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-style: italic;
  }

  /* Why section */
  .newsletter-why {
    padding: 5rem 0;
    background: var(--color-bg);
  }

  .why-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 2.5rem;
    font-family: var(--font-heading);
  }

  .why-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .why-card {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .why-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }

  .why-card p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }
</style>
