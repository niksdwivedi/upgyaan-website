---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Become a Mentor — UpGyaan"
  description="Mentor with UpGyaan. Share what took you years to learn. Shape the careers of the next generation of tech professionals."
>

  <!-- ── Hero ───────────────────────────────────────────── -->
  <section class="mentor-hero" aria-labelledby="mentor-heading">
    <div class="container">
      <p class="section-kicker">Become a mentor</p>
      <h1 id="mentor-heading">Share what took you years to learn</h1>
      <p class="page-intro">
        UpGyaan mentors are senior technology practitioners, startup founders, and researchers who want to give back — genuinely, and without an organisational agenda. If that sounds like you, we want to hear from you.
      </p>
      <a href="#mentor-register" class="btn-primary">Express your interest</a>
    </div>
  </section>

  <!-- ── Why mentor with UpGyaan ────────────────────────── -->
  <section class="content-section reveal" aria-labelledby="why-mentor-heading">
    <div class="container two-col">
      <div class="col-text">
        <p class="section-kicker">Why UpGyaan</p>
        <h2 id="why-mentor-heading">Mentorship with no hidden agenda</h2>
        <p>
          Most structured mentorship programmes have a conflict at the centre: the organisation running them has a stake in the outcome. Retention. Productivity. Employer brand. The mentor is expected to serve multiple masters.
        </p>
        <p>
          UpGyaan is different. Mentors here have one job: help the person in front of them think more clearly about where they want to go. No organisational agenda. No performance review implications. No retention goals dressed up as career development.
        </p>
        <p>
          The people who mentor with us do it because they remember what it was like to navigate transitions without the right guidance — and they want to be the person they wish they had.
        </p>
      </div>
      <div class="col-visual">
        <div class="mentor-quote-card">
          <p class="mqc-text">&#8220;The community I wish had existed when I was navigating the transitions that defined my career.&#8221;</p>
          <p class="mqc-attr">— The founding conviction behind UpGyaan</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What you bring ─────────────────────────────────── -->
  <section class="content-section bg-surface reveal" aria-labelledby="bring-heading">
    <div class="container">
      <p class="section-kicker">Who we're looking for</p>
      <h2 id="bring-heading" class="section-heading">Different backgrounds. One common thread.</h2>
      <p class="section-sub-text">UpGyaan mentors come from across the spectrum of the technology world. What unites them is not a job title — it is the experience of having navigated the transitions our members are facing.</p>

      <div class="mentor-types-grid">
        <div class="mentor-type-card">
          <div class="mt-icon" aria-hidden="true">🏢</div>
          <h3>Enterprise Leaders</h3>
          <p>Senior technology professionals who have spent careers inside large organisations — navigating the corporate ladder, managing teams, influencing strategy, and building things that scale.</p>
          <ul class="mt-fit-list">
            <li>Directors, VPs, and Heads of Technology</li>
            <li>Enterprise architects and principal engineers</li>
            <li>Technology leaders in banking, fintech, insurance, and large-scale infrastructure</li>
          </ul>
        </div>
        <div class="mentor-type-card">
          <div class="mt-icon" aria-hidden="true">🚀</div>
          <h3>Startup Founders</h3>
          <p>People who have built companies from scratch and understand what unconventional career paths look like — the non-linear routes, the bold bets, and the lessons that only come from having skin in the game.</p>
          <ul class="mt-fit-list">
            <li>Founders at any stage — from early-stage to exit</li>
            <li>CTOs and technical co-founders</li>
            <li>Operators who have navigated the startup-to-scale journey</li>
          </ul>
        </div>
        <div class="mentor-type-card">
          <div class="mt-icon" aria-hidden="true">🎓</div>
          <h3>Academic Researchers</h3>
          <p>Researchers and professors from leading universities who sit at the intersection of cutting-edge knowledge and real-world application — bringing a rigour and depth of perspective that is rare in professional communities.</p>
          <ul class="mt-fit-list">
            <li>Computer science and engineering faculty</li>
            <li>AI, data science, and systems researchers</li>
            <li>Practitioners with strong academic backgrounds</li>
          </ul>
        </div>
        <div class="mentor-type-card">
          <div class="mt-icon" aria-hidden="true">🤝</div>
          <h3>Peer Mentors &amp; Alumni</h3>
          <p>Members who have recently navigated the transition someone else is now approaching. Often the most directly useful perspective — because the experience is recent and the context is fresh.</p>
          <ul class="mt-fit-list">
            <li>Recent IC-to-lead transitions</li>
            <li>Mid-career professionals 2–3 steps ahead</li>
            <li>Community members who want to give back</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What you get ────────────────────────────────────── -->
  <section class="content-section reveal" aria-labelledby="get-heading">
    <div class="container">
      <p class="section-kicker">What you get</p>
      <h2 id="get-heading" class="section-heading">Mentoring here is not a one-way transaction</h2>
      <p class="section-sub-text">The best mentors will tell you: giving back is one of the most effective ways to sharpen your own thinking. UpGyaan is structured to make that dynamic explicit.</p>

      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2l2.2 4.5 5 .7-3.6 3.5.85 5-4.45-2.35L6.55 15.7l.85-5L3.8 7.2l5-.7L11 2z" stroke="#0D7377" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </div>
          <h3>Thought leadership</h3>
          <p>Contribute to the UpGyaan blog, newsletter, and content ecosystem. Your perspective reaches an audience of ambitious tech professionals actively looking for exactly what you have learned.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="8" cy="8" r="4" stroke="#0D7377" stroke-width="1.5"/><circle cx="16" cy="15" r="4" stroke="#0D7377" stroke-width="1.5"/><path d="M12 9c1 .5 2.5 2 2.5 4" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>A motivated talent pipeline</h3>
          <p>Build genuine relationships with the next generation of tech talent — people who are developing real skills, building visible track records, and are known quantities within the community.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2C6.03 2 2 6.03 2 11s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9z" stroke="#0D7377" stroke-width="1.5"/><path d="M7 11l3 3 5-5" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Structured, manageable commitment</h3>
          <p>Mentorship within UpGyaan is designed to be genuinely sustainable. Cohort-based, time-bound, and matched thoughtfully — so the commitment is meaningful without being overwhelming.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="3" width="16" height="16" rx="3" stroke="#0D7377" stroke-width="1.5"/><path d="M7 11h8M11 7v8" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>A community of peers</h3>
          <p>Connect with other mentors — senior practitioners, founders, and researchers — who share a commitment to the next generation. The mentor community is a valuable network in its own right.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M2 12s3-7 9-7 9 7 9 7-3 7-9 7-9-7-9-7z" stroke="#0D7377" stroke-width="1.5"/><circle cx="11" cy="12" r="3" stroke="#0D7377" stroke-width="1.5"/></svg>
          </div>
          <h3>Stay sharp, stay relevant</h3>
          <p>Mentoring forces you to articulate what you know. The questions ambitious early and mid-career professionals ask are often the most clarifying questions you will encounter. Many mentors cite this as the unexpected benefit they value most.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" stroke="#0D7377" stroke-width="1.5"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" stroke="#0D7377" stroke-width="1.5"/></svg>
          </div>
          <h3>Community recognition</h3>
          <p>Your contributions are visible within the community. The professionals who grow through your mentorship become vocal advocates — and the relationships you build here extend well beyond any formal programme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How it works ────────────────────────────────────── -->
  <section class="content-section bg-surface reveal" aria-labelledby="how-heading">
    <div class="container content-narrow">
      <p class="section-kicker">How it works</p>
      <h2 id="how-heading">Simple, structured, and built around your availability</h2>
      <ol class="how-list">
        <li>
          <span class="how-num" aria-hidden="true">1</span>
          <div>
            <h3>Express your interest</h3>
            <p>Tell us a little about your background, the kind of transitions you have navigated, and what you are hoping to contribute. No formal application — just a conversation starter.</p>
          </div>
        </li>
        <li>
          <span class="how-num" aria-hidden="true">2</span>
          <div>
            <h3>We find the right match</h3>
            <p>Matching is thoughtful, not algorithmic. We look for alignment between what the mentee is facing and what the mentor has lived through — not just job titles and industries.</p>
          </div>
        </li>
        <li>
          <span class="how-num" aria-hidden="true">3</span>
          <div>
            <h3>A defined, manageable cohort</h3>
            <p>Each Mentor Circle cohort runs for a defined period. The commitment is structured and agreed upfront — so you know what you are taking on, and you can plan around it.</p>
          </div>
        </li>
        <li>
          <span class="how-num" aria-hidden="true">4</span>
          <div>
            <h3>The relationship continues beyond the cohort</h3>
            <p>The formal programme ends. The relationship does not have to. Many of the most valuable mentor relationships in UpGyaan started as structured cohorts and became long-term connections.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Register interest ───────────────────────────────── -->
  <section id="mentor-register" class="content-section reveal" aria-labelledby="mentor-cta-heading">
    <div class="container content-narrow">
      <p class="section-kicker">Get involved</p>
      <h2 id="mentor-cta-heading" class="section-heading">Tell us you're interested</h2>
      <p class="cta-sub">
        Mentor Circle launches in Phase 2. If you want to be considered when applications open, register your interest now and we will be in touch before any public announcement.
      </p>
      <div class="mentor-form-wrap" data-context="mentor">
        <form id="mentor-interest-form" class="mentor-form" novalidate aria-label="Mentor interest form">
          <input type="hidden" name="context" value="mentor" />

          <div class="mf-row">
            <div class="mf-field">
              <label for="mf-firstname" class="mf-label">First name <span aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
              <input type="text" id="mf-firstname" name="firstName" class="mf-input" placeholder="Your first name" autocomplete="given-name" required aria-required="true" aria-describedby="mf-firstname-error" />
              <span id="mf-firstname-error" class="mf-error" role="alert" aria-live="polite" hidden></span>
            </div>

            <div class="mf-field">
              <label for="mf-email" class="mf-label">Email address <span aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
              <input type="email" id="mf-email" name="email" class="mf-input" placeholder="you@example.com" autocomplete="email" required aria-required="true" aria-describedby="mf-email-error" />
              <span id="mf-email-error" class="mf-error" role="alert" aria-live="polite" hidden></span>
            </div>
          </div>

          <div class="mf-field mf-field--full">
            <label for="mf-linkedin" class="mf-label">
              LinkedIn profile URL <span class="mf-optional">(strongly encouraged)</span>
            </label>
            <input type="url" id="mf-linkedin" name="linkedin" class="mf-input" placeholder="https://linkedin.com/in/yourname" autocomplete="url" aria-describedby="mf-linkedin-hint mf-linkedin-error" />
            <span id="mf-linkedin-hint" class="mf-hint">Helps us match you to the right mentees when Mentor Circle opens.</span>
            <span id="mf-linkedin-error" class="mf-error" role="alert" aria-live="polite" hidden></span>
          </div>

          <button type="submit" class="btn-primary mf-submit">Express my interest</button>
        </form>

        <p class="mf-privacy">No spam. We will only contact you when Mentor Circle applications open. <a href="/privacy">Privacy policy</a>.</p>

        <div class="mf-success" role="status" aria-live="polite" aria-atomic="true" hidden>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="9" stroke="#0D7377" stroke-width="1.5"/>
            <path d="M6 10l3 3 5-5" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Thank you — we've noted your interest as a mentor. We'll be in touch before Mentor Circle launches.</span>
        </div>
      </div>

      <p class="mentor-contact-note">
        Prefer to talk first?
        <a href={`mailto:${siteConfig.contact.email}`} class="text-link-inline">Get in touch directly</a>
        — we are happy to answer questions before you commit to anything.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .mentor-hero {
    padding: 5rem 0 4rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .mentor-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700; margin: 0.5rem 0 1rem;
  }
  .page-intro {
    font-size: 1.125rem; color: var(--color-text);
    line-height: 1.7; max-width: 640px; margin: 0 0 1.75rem;
  }

  .content-section { padding: 5rem 0; border-bottom: 1px solid var(--color-border); }
  .content-section:last-child { border-bottom: none; }
  .bg-surface { background: var(--color-surface); }
  .content-narrow { max-width: 760px; }

  .section-kicker {
    font-size: 0.8125rem; font-weight: 600;
    color: var(--color-teal); text-transform: uppercase;
    letter-spacing: 0.08em; margin: 0 0 0.5rem;
  }
  .section-heading { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; margin: 0 0 1.25rem; }
  .section-sub-text { font-size: 1.0625rem; color: var(--color-text); line-height: 1.7; max-width: 680px; margin: 0 0 2.5rem; }

  .two-col { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .two-col { grid-template-columns: 1fr 1fr; } }

  .mentor-quote-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-teal);
    border-radius: 0 10px 10px 0;
    padding: 2rem;
  }
  .mqc-text { font-size: 1.125rem; font-style: italic; color: var(--color-black); line-height: 1.7; margin: 0 0 1rem; }
  .mqc-attr { font-size: 0.875rem; color: var(--color-muted); margin: 0; }

  .mentor-types-grid {
    display: grid; gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .mentor-types-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .mentor-types-grid { grid-template-columns: repeat(4, 1fr); } }

  .mentor-type-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px; padding: 1.5rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .mt-icon { font-size: 1.75rem; }
  .mentor-type-card h3 { font-size: 1rem; font-weight: 700; color: var(--color-black); margin: 0; }
  .mentor-type-card > p { font-size: 0.875rem; color: var(--color-text); line-height: 1.6; margin: 0; }
  .mt-fit-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .mt-fit-list li { font-size: 0.8125rem; color: var(--color-muted); padding-left: 1rem; position: relative; }
  .mt-fit-list li::before { content: "→"; position: absolute; left: 0; color: var(--color-teal); font-size: 0.75rem; }

  .benefits-grid {
    display: grid; gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .benefits-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .benefits-grid { grid-template-columns: repeat(3, 1fr); } }

  .benefit-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px; padding: 1.5rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .benefit-icon {
    width: 40px; height: 40px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .benefit-card h3 { font-size: 0.9375rem; font-weight: 700; color: var(--color-black); margin: 0; }
  .benefit-card p { font-size: 0.875rem; color: var(--color-text); line-height: 1.6; margin: 0; }

  .how-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2rem; counter-reset: none; }
  .how-list li { display: flex; gap: 1.25rem; align-items: flex-start; }
  .how-num {
    flex-shrink: 0;
    width: 36px; height: 36px;
    background: var(--color-teal);
    color: #fff;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 0.875rem;
    margin-top: 0.25rem;
  }
  .how-list h3 { font-size: 1rem; font-weight: 700; margin: 0 0 0.35rem; color: var(--color-black); }
  .how-list p { font-size: 0.9375rem; color: var(--color-text); line-height: 1.6; margin: 0; }

  .cta-sub { font-size: 1.0625rem; color: var(--color-text); line-height: 1.7; margin: 0 0 2rem; }
  .mentor-contact-note { font-size: 0.9rem; color: var(--color-muted); margin-top: 1.5rem; }
  .text-link-inline { color: var(--color-teal); text-decoration: underline; text-underline-offset: 3px; }

  /* ── Mentor interest form ─────────────────────────────── */
  .mentor-form { display: flex; flex-direction: column; gap: 1rem; }
  .mf-row { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .mf-row { grid-template-columns: 1fr 1fr; } }
  .mf-field { display: flex; flex-direction: column; gap: 0.3rem; }
  .mf-field--full { grid-column: 1 / -1; }
  .mf-label { font-size: 0.9rem; font-weight: 600; color: var(--color-black); }
  .mf-optional { font-weight: 400; color: var(--color-muted); font-size: 0.8125rem; }
  .mf-input {
    padding: 0.6rem 0.875rem;
    border: 1.5px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.9375rem;
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-black);
    transition: border-color 0.15s ease;
    width: 100%;
  }
  .mf-input:focus { outline: none; border-color: var(--color-teal); box-shadow: 0 0 0 3px rgba(13,115,119,0.12); }
  .mf-input[aria-invalid="true"] { border-color: #c0392b; }
  .mf-hint { font-size: 0.8125rem; color: var(--color-muted); }
  .mf-error { font-size: 0.8125rem; color: #c0392b; font-weight: 500; }
  .mf-error[hidden] { display: none; }
  .mf-submit { align-self: flex-start; margin-top: 0.5rem; }
  .mf-privacy { font-size: 0.8125rem; color: var(--color-muted); margin: 0.75rem 0 0; }
  .mf-privacy a { color: var(--color-muted); text-underline-offset: 2px; }
  .mf-privacy a:hover { color: var(--color-teal); }
  .mf-success {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    background: #f0faf9; border: 1.5px solid #0D7377;
    border-radius: 8px; font-weight: 500; color: #0D7377;
    font-size: 0.9375rem; margin-top: 0.75rem;
  }
  .mf-success[hidden] { display: none; }
  .mentor-form[hidden] { display: none; }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

<script>
  const form = document.getElementById('mentor-interest-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const firstNameInput = form.querySelector<HTMLInputElement>('#mf-firstname');
      const emailInput = form.querySelector<HTMLInputElement>('#mf-email');
      const linkedinInput = form.querySelector<HTMLInputElement>('#mf-linkedin');
      const submitBtn = form.querySelector<HTMLButtonElement>('.mf-submit');
      const successEl = form.closest('.mentor-form-wrap')?.querySelector<HTMLElement>('.mf-success');

      // Clear errors
      form.querySelectorAll<HTMLElement>('.mf-error').forEach(el => { el.hidden = true; el.textContent = ''; });
      form.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'));

      let hasError = false;

      if (!firstNameInput?.value.trim()) {
        const err = document.getElementById('mf-firstname-error');
        if (err && firstNameInput) { err.textContent = 'Please enter your first name.'; err.hidden = false; firstNameInput.setAttribute('aria-invalid', 'true'); hasError = true; }
      }

      const emailVal = emailInput?.value.trim() ?? '';
      if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        const err = document.getElementById('mf-email-error');
        if (err && emailInput) { err.textContent = 'Please enter a valid email address.'; err.hidden = false; emailInput.setAttribute('aria-invalid', 'true'); hasError = true; }
      }

      const linkedinVal = linkedinInput?.value.trim() ?? '';
      if (linkedinVal && !/^https?:\/\//i.test(linkedinVal)) {
        const err = document.getElementById('mf-linkedin-error');
        if (err && linkedinInput) { err.textContent = 'Please enter a full URL starting with https://'; err.hidden = false; linkedinInput.setAttribute('aria-invalid', 'true'); hasError = true; }
      }

      if (hasError) { (form.querySelector('[aria-invalid="true"]') as HTMLElement)?.focus(); return; }

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

      try {
        const data: Record<string, string> = {};
        new FormData(form).forEach((val, key) => { data[key] = String(val); });

        const res = await fetch('/api/interest', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });

        if (res.ok) {
          form.hidden = true;
          if (successEl) successEl.hidden = false;
        } else { throw new Error('Server error'); }
      } catch {
        const anyErr = form.querySelector<HTMLElement>('.mf-error');
        if (anyErr) { anyErr.textContent = 'Something went wrong. Please try again.'; anyErr.hidden = false; }
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Express my interest'; }
      }
    });
  }
</script>
