---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="For Organisations — UpGyaan"
  description="Partner with UpGyaan to build a culture of continuous growth, retain your best talent, and connect your teams with a community that compounds."
>

  <!-- ── Hero ───────────────────────────────────────────── -->
  <section class="org-hero" aria-labelledby="org-heading">
    <div class="container">
      <p class="section-kicker">For organisations</p>
      <h1 id="org-heading">Invest in your people — beyond the organisation's walls</h1>
      <p class="page-intro">
        The most motivated, high-performing tech professionals are the ones who feel they are growing — not just delivering. UpGyaan gives organisations a way to invest in that growth in a way that corporate L&amp;D programmes were never designed to.
      </p>
      <a href="#org-register" class="btn-primary">Start a conversation</a>
    </div>
  </section>

  <!-- ── The problem ────────────────────────────────────── -->
  <section class="content-section reveal" aria-labelledby="org-problem-heading">
    <div class="container two-col">
      <div class="col-text">
        <p class="section-kicker">The problem</p>
        <h2 id="org-problem-heading">Corporate L&amp;D was not built for career growth</h2>
        <p>
          Most corporate learning and development is designed around the organisation's needs: compliance, onboarding, role-specific skills. These are important. They are not the same as career development.
        </p>
        <p>
          Your best tech professionals — the ones you most want to retain — are asking questions that your internal programmes cannot answer. How do I position for a promotion? How do I move from IC to lead? How do I build the kind of visibility that creates options? What does the next five years of my career actually look like?
        </p>
        <p>
          When they cannot find the answers inside, they look outside. And when they find a community outside that gives them what they need, your organisation becomes one option among many — rather than the clear choice.
        </p>
      </div>
      <div class="col-visual">
        <div class="org-stat-block">
          <div class="org-stat">
            <p class="org-stat-num">87%</p>
            <p class="org-stat-label">of tech professionals say career growth opportunities are a top factor in deciding whether to stay at an organisation</p>
          </div>
          <div class="org-stat">
            <p class="org-stat-num">2×</p>
            <p class="org-stat-label">Professionals who feel they are growing are twice as likely to report high engagement at work</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What UpGyaan offers organisations ──────────────── -->
  <section class="content-section bg-surface reveal" aria-labelledby="org-offer-heading">
    <div class="container">
      <p class="section-kicker">What we offer</p>
      <h2 id="org-offer-heading" class="section-heading">A career growth infrastructure your L&amp;D team cannot build alone</h2>
      <p class="section-sub-text">UpGyaan's corporate partnerships give your tech teams access to the full ecosystem — community, mentorship, structured learning, and visibility infrastructure — while giving your organisation insights and frameworks that compound over time.</p>

      <div class="org-offer-grid">
        <div class="org-offer-card">
          <div class="offer-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Community access for your teams</h3>
          <p>Your tech professionals gain access to the full UpGyaan community — structured peer groups, mentorship matching, the Academy, and the Visibility Engine — as a benefit of working at your organisation.</p>
        </div>
        <div class="org-offer-card">
          <div class="offer-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Structured career frameworks</h3>
          <p>Access to UpGyaan's career progression frameworks — the kind of clarity about what different levels actually require that organisations consistently struggle to communicate internally.</p>
        </div>
        <div class="org-offer-card">
          <div class="offer-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#0D7377" stroke-width="1.5"/><path d="M12 8v4l3 3" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>AI-backed growth insights</h3>
          <p>As the UpGyaan AI layer matures, corporate partners gain access to anonymised, aggregated insights about where their tech teams are in their career trajectories — and where the highest-leverage development investments are.</p>
        </div>
        <div class="org-offer-card">
          <div class="offer-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Access to talent</h3>
          <p>Corporate partners get priority access to the UpGyaan Career Launchpad — a pipeline of professionals with community-validated skills and track records, who are open to the right opportunity.</p>
        </div>
        <div class="org-offer-card">
          <div class="offer-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Employer brand</h3>
          <p>Organisations that invest in career growth beyond the role are the ones that attract ambitious professionals. UpGyaan partnership signals that your organisation takes development seriously — in a way that a standard L&amp;D budget cannot.</p>
        </div>
        <div class="org-offer-card">
          <div class="offer-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="#0D7377" stroke-width="1.5"/><path d="M3 9h18M9 21V9" stroke="#0D7377" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>Sponsorship &amp; event presence</h3>
          <p>Sponsor UpGyaan events, cohorts, and content — reaching a concentrated audience of motivated, growing tech professionals who are exactly the kind of people you want on your radar.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How partnerships work ──────────────────────────── -->
  <section class="content-section reveal" aria-labelledby="how-partner-heading">
    <div class="container content-narrow">
      <p class="section-kicker">How it works</p>
      <h2 id="how-partner-heading">Built around your context, not a fixed package</h2>
      <p>
        We do not offer off-the-shelf corporate packages. Every organisation is different — the size of your team, the career stage of the people you want to support, the development challenges you are trying to solve, the role you want to play in the community.
      </p>
      <p>
        Corporate partnerships at UpGyaan start with a conversation. Tell us what you are trying to achieve for your people. We will tell you honestly what we can do, when we can do it, and what it looks like in practice.
      </p>
      <p>
        Partnerships open in Phase 2. If you want to be considered as an early corporate partner, register your interest below and we will be in touch.
      </p>
    </div>
  </section>

  <!-- ── Register interest ───────────────────────────────── -->
  <section id="org-register" class="content-section bg-surface reveal" aria-labelledby="org-cta-heading">
    <div class="container content-narrow">
      <p class="section-kicker">Start a conversation</p>
      <h2 id="org-cta-heading" class="section-heading">Tell us about your organisation</h2>
      <p class="cta-sub">
        Whether you are thinking about community access for your teams, a sponsorship conversation, or something else entirely — we would love to hear from you.
      </p>
      <EmailCapture id="org-cta" context="organisation" />
      <p class="org-contact-note">
        Prefer to talk directly?
        <a href={`mailto:${siteConfig.contact.email}`} class="text-link-inline">Email us</a>
        — we respond to every inquiry personally.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .org-hero {
    padding: 5rem 0 4rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .org-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700; margin: 0.5rem 0 1rem;
  }
  .page-intro {
    font-size: 1.125rem; color: var(--color-text);
    line-height: 1.7; max-width: 640px; margin: 0 0 1.75rem;
  }

  .content-section { padding: 5rem 0; border-bottom: 1px solid var(--color-border); }
  .content-section:last-child { border-bottom: none; }
  .bg-surface { background: var(--color-surface); }
  .content-narrow { max-width: 760px; }

  .section-kicker {
    font-size: 0.8125rem; font-weight: 600;
    color: var(--color-teal); text-transform: uppercase;
    letter-spacing: 0.08em; margin: 0 0 0.5rem;
  }
  .section-heading { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; margin: 0 0 1.25rem; }
  .section-sub-text { font-size: 1.0625rem; color: var(--color-text); line-height: 1.7; max-width: 680px; margin: 0 0 2.5rem; }

  .two-col { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .two-col { grid-template-columns: 1fr 1fr; } }

  .org-stat-block {
    display: flex; flex-direction: column; gap: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px; padding: 2rem;
  }
  .org-stat-num { font-size: 2.5rem; font-weight: 800; color: var(--color-teal); margin: 0 0 0.4rem; line-height: 1; }
  .org-stat-label { font-size: 0.9rem; color: var(--color-text); line-height: 1.5; margin: 0; }

  .org-offer-grid {
    display: grid; gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .org-offer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .org-offer-grid { grid-template-columns: repeat(3, 1fr); } }

  .org-offer-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px; padding: 1.5rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .offer-icon {
    width: 40px; height: 40px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .org-offer-card h3 { font-size: 0.9375rem; font-weight: 700; color: var(--color-black); margin: 0; }
  .org-offer-card p { font-size: 0.875rem; color: var(--color-text); line-height: 1.6; margin: 0; }

  .content-narrow p { font-size: 1.0625rem; color: var(--color-text); line-height: 1.75; margin: 0 0 1.25rem; }
  .content-narrow p:last-of-type { margin-bottom: 0; }

  .cta-sub { font-size: 1.0625rem; color: var(--color-text); line-height: 1.7; margin: 0 0 2rem; }
  .org-contact-note { font-size: 0.9rem; color: var(--color-muted); margin-top: 1.5rem; }
  .text-link-inline { color: var(--color-teal); text-decoration: underline; text-underline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
